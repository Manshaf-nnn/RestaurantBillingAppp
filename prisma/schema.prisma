// ──────────────────────────────────────────────────────────── tenancy ──────

model Restaurant {
  id   String @id @default(cuid())
  slug String @unique

  /// The restaurant's own domain, e.g. "nilaza.lk".
  ///
  /// Stored bare: lower-cased, no scheme, no `www.`, no port — so the matcher
  /// has one shape to compare against however a guest types it.
  ///
  /// Unique across the platform, because a hostname can only mean one
  /// restaurant. Null is the ordinary case: they use the shared address.
  customDomain           String?   @unique
  /// When the app confirmed it actually answers on that domain.
  ///
  /// An unverified domain resolves NOTHING. Without that rule, writing a row
  /// would be enough to point a hostname at somebody else's menu — the check
  /// is what makes the claim real rather than asserted.
  customDomainVerifiedAt DateTime?
  name                   String
  tagline                String?
  description            String?
  logoUrl                String?
  coverUrl               String?
  email                  String?
  phone                  String?
  addressLine            String?
  city                   String?
  state                  String?
  country                String?   @default("IN")
  postalCode             String?
  timezone               String    @default("Asia/Kolkata")
  /// Whether an outward movement may take a balance below zero.
  ///
  /// Off by default, which is what workflow.md asks for. It was hardcoded on:
  /// a sale could always drive stock negative and `wentNegative` was computed
  /// and never read by anything.
  ///
  /// Turning it ON is a legitimate choice for a busy kitchen — refusing to serve
  /// a guest because a delivery was not keyed in is usually the worse outcome —
  /// so it is the owner's decision rather than ours.
  allowNegativeStock     Boolean   @default(false)
  locale                 String    @default("en")
  currency               String    @default("INR")

  /// basis points — 500 = 5.00%
  taxRateBps       Int     @default(500)
  taxLabel         String  @default("GST")
  taxInclusive     Boolean @default(false)
  serviceChargeBps Int     @default(0)
  /// The owner's expected food-cost share of sales, in basis points
  /// (3000 = 30%). Null means no target set; the variance screen compares
  /// against it when present. acCal.md §8.
  targetFoodCostBps Int?

  plan        SubscriptionPlan @default(TRIAL)
  trialEndsAt DateTime?

  /// Onboarding lifecycle. New self-service registrations start PENDING and
  /// require platform-admin approval; `isActive` mirrors whether the tenant is
  /// currently enabled (approved and not suspended).
  status          RestaurantStatus @default(ACTIVE)
  isActive        Boolean          @default(true)
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  /// [OpeningHours] — { mon: { open: "09:00", close: "23:00", closed: false }, ... }
  openingHours  Json?
  /// [ThemeConfig] — { primary: "24 95% 53%", radius: "0.75rem", mode: "system" }
  theme         Json?
  /// [PrinterConfig] — { kitchen: { width: 80 }, receipt: { width: 58 }, autoPrint: true }
  printerConfig Json?
  /// [PaymentConfig] — { cash: true, card: true, qr: true, upiId: "x@bank", online: false }
  paymentConfig Json?
  /// Dead since it was added: written once at registration, read by nothing.
  /// Superseded by `enabledFeatures` below, which is a real list the platform
  /// operator controls rather than a shape nobody agreed on.
  features      Json?

  /// Which features this restaurant has bought.
  ///
  /// Keys from `src/features/access/features.ts` — the registry that already
  /// drives the sidebar, the role builder and the page guards. There is no
  /// second list to keep in step.
  ///
  /// **Empty means everything.** Not "nothing": selling a restaurant zero
  /// features is meaningless, while "we have not restricted this tenant" is the
  /// normal case and must not require writing 45 rows for every existing
  /// customer. Same spirit as `approvalPolicy` below — absent means the
  /// built-in default applies.
  ///
  /// Disabling a feature never touches its data. The rows stay exactly where
  /// they are and come back the moment it is re-enabled.
  enabledFeatures  String[]        @default([])
  /// Which package that list came from, for display and for upgrade/downgrade.
  /// The resolved list above is the authority — a per-restaurant tweak diverges
  /// from its package rather than being silently overwritten by it.
  featurePackageId String?
  featurePackage   FeaturePackage? @relation(fields: [featurePackageId], references: [id], onDelete: SetNull)

  loyaltyEnabled      Boolean @default(true)
  /// points awarded per unit of currency spent, x100 (100 = 1 point per 1 currency)
  loyaltyEarnRateX100 Int     @default(100)
  /// minor units of currency each redeemed point is worth
  loyaltyPointValue   Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  categories       Category[]
  foods            Food[]
  tables           RestaurantTable[]
  customers        Customer[]
  orders           Order[]
  payments         Payment[]
  refunds          Refund[]
  invoices         Invoice[]
  coupons          Coupon[]
  loyaltyEntries   LoyaltyEntry[]
  counters         RestaurantCounter[]
  tableSessions    TableSession[]
  printJobs        PrintJob[]
  expenseCategories ExpenseCategory[]
  outgoingPayments  OutgoingPayment[]
  accountantNotes   AccountantNote[]
  bankStatements    BankStatement[]
  bankStatementLines BankStatementLine[]
  dailyCloses      DailyClose[]
  accountingPeriods AccountingPeriod[]
  reservations     Reservation[]
  reviews          Review[]
  feedback         Feedback[]
  shiftNotes       ShiftNote[]
  instructions     BranchInstruction[]
  units            Unit[]
  stockCategories  InventoryCategory[]
  supplierPayments SupplierPayment[]
  foodBranches     FoodBranch[]
  kitchenStations  KitchenStation[]
  suppliers        Supplier[]
  inventoryItems   InventoryItem[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  serviceRequests  ServiceRequest[]
  shifts           StaffShift[]
  mediaBackups     MediaBackup[]
  mediaAssets      MediaAsset[]
  invites          Invite[]
  staffRoles       StaffRole[]
  menuSnapshots    RestaurantMenuSnapshot[]
  branches         Branch[]
  cashDrawers      CashDrawerSession[]
  cashRegisters    CashRegister[]
  pettyCash        PettyCashRequest[]
  cashHandovers    CashHandover[]
  storageLocations StorageLocation[]
  stockCounts      StockCount[]
  recipes          Recipe[]
  goodsReceipts    GoodsReceipt[]
  purchaseReturns  PurchaseReturn[]
  stockBatches     StockBatch[]
  wastageRecords   WastageRecord[]
  inventoryStock   InventoryStock[]
  stockTransfers   StockTransfer[]
  productionOrders ProductionOrder[]
  productionSpecs  ProductionSpec[]
  approvalRequests ApprovalRequest[]
  outboxEvents     OutboxEvent[]
  errorLogs        ErrorLog[]
  jobs             Job[]
  /// [ApprovalPolicy] — thresholds above which an action needs a second
  /// pair of eyes. Null means the built-in defaults apply.
  approvalPolicy   Json?
  /// [LiveBoardPolicy] — the live floor board's waiting-time bands, customer
  /// tiers, return-gap days and alert timings. Null means the built-in
  /// defaults apply, which is why the board works before anyone configures it.
  ///
  /// Separate from `approvalPolicy` on purpose: that one answers "how much is
  /// worth a second pair of eyes", which is a different question from "how long
  /// is too long to wait for food".
  liveBoardPolicy  Json?

  @@index([isActive])
  @@map("restaurants")
}

/**
 * The transactional outbox (production.md §5).
 *
 * ── The problem it solves ───────────────────────────────────────────────────
 *
 * Realtime used to be fire-and-forget: `realtime.orderCreated(...)` was called
 * AFTER the transaction committed, and on the serverless host it is a no-op
 * because no Socket.IO server exists there. So the event describing an order
 * had no durable existence anywhere. If it was not delivered, it was gone, and
 * nothing could say afterwards what had happened or replay it.
 *
 * A row here is written INSIDE the same transaction as the order, payment or
 * stock movement it describes. The two commit together or roll back together,
 * so an event can never describe something that did not happen, and something
 * that happened can never lack its event. That is the whole point: realtime
 * failure must not lose an order.
 *
 * ── How it is read ──────────────────────────────────────────────────────────
 *
 * `/api/pulse?since=<seq>` returns the rows after a cursor, and the client
 * dedups on `id`. Note carefully what the cursor is and is not: `seq` orders
 * events and identifies them, but a Postgres sequence hands out numbers at
 * INSERT time while visibility arrives at COMMIT time, so a slow transaction
 * can commit seq 10 after seq 11 is already visible. A reader that trusted the
 * cursor alone could step over it.
 *
 * It does not have to, because the pulse token is still there and is derived
 * from `MAX(updatedAt)` — it cannot miss a change, only fail to name it. The
 * two halves have different jobs and cover each other's weakness: the token
 * guarantees the client learns SOMETHING changed, the outbox tells it WHAT and
 * lets it dedup. A skipped event still triggers a refresh.
 *
 * ── Retention ───────────────────────────────────────────────────────────────
 *
 * Trimmed by the `outbox-trim` background job. This is a delivery log, not a
 * second copy of the business record — the order, payment and movement are the
 * facts, and they are kept elsewhere for ever.
 */
model OutboxEvent {
  /// Monotonic within a restaurant, and the client's cursor. BigInt because a
  /// busy multi-tenant platform will exhaust an Int in a way that is very
  /// awkward to discover in production.
  seq          BigInt     @id @default(autoincrement())
  id           String     @unique @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Where it happened, so a branch's screens are not woken by another branch.
  /// Null means restaurant-wide (a menu change, a settings change).
  branchId     String?

  /// The event name, from EVENTS in src/lib/realtime/events.ts.
  type     String
  /// What kind of record moved: 'Order', 'Payment', 'StockMovement'.
  entity   String
  entityId String?
  /// Just enough for a screen to decide whether it cares. Never a full record:
  /// this table is read by pollers and must stay cheap.
  payload  Json?

  createdAt DateTime @default(now())

  @@index([restaurantId, seq])
  @@index([restaurantId, branchId, seq])
  @@index([createdAt])
  @@map("outbox_events")
}

/// Backups of uploaded media for platform-level restore/migration.
/// Durable image storage.
///
/// Uploaded image bytes live *in the database*, not on the host's disk or in a
/// host-scoped blob store. This is deliberate: Netlify Blobs and the build
/// filesystem are scoped to a Netlify site, so moving the site to another
/// Netlify account (or simply redeploying onto a fresh one) silently destroys
/// every uploaded photo while the database still points at them. Postgres is
/// the only store that survives that move, so it is the source of truth and
/// nothing ever needs "restoring".
model MediaAsset {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  /// public filename — `<timestamp>-<hex>.<ext>`, served at /api/media/<key>
  key         String @unique
  contentType String
  size        Int
  /// sha-256 of `data`, used as a strong ETag for conditional requests
  checksum    String
  /// the image itself (bytea)
  data        Bytes

  /// mirrored copy on a CDN (Cloudinary) when one is configured; the row is
  /// still authoritative, so losing the CDN account costs performance, not data
  cdnUrl String?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@map("media_assets")
}

model MediaBackup {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  key         String? // internal key (uploads filename or blob key)
  originalUrl String // URL returned to tenant at upload time
  backupUrl   String? // URL in backup storage (Cloudinary) when available
  contentType String?
  size        Int?
  notes       String? // optional note about source (uploader, field name)

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@map("media_backups")
}

/// Snapshot of each restaurant menu item/category, mirrored to the platform admin so
/// changes are visible even when the tenant account is moved or the site changes.
model RestaurantMenuSnapshot {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  entityType   String // CATEGORY | FOOD
  entityId     String
  name         String
  slug         String?
  categoryName String?
  imageUrl     String?
  price        Int?
  snapshot     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, entityType, entityId])
  @@index([restaurantId, createdAt])
  @@map("restaurant_menu_snapshots")
}

// ───────────────────────────────────────────────── identity & access ───────

model User {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  role         UserRole @default(WAITER)
  /// extra permission keys granted on top of whatever the role gives
  permissions  String[] @default([])

  /// The restaurant's own role, when this person holds one. Its permission
  /// list REPLACES the preset defaults — see `permissionsFor` in lib/rbac.ts.
  staffRoleId String?
  staffRole   StaffRole? @relation("UserStaffRole", fields: [staffRoleId], references: [id], onDelete: SetNull)

  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /*
   * MFA for privileged accounts (production.md §14).
   *
   * The secret is stored encrypted, not hashed: TOTP verification needs the
   * original to recompute the code, so it cannot be a one-way digest the way a
   * password is. `mfaEnabledAt` is the switch — a secret exists from the moment
   * enrolment starts, and only counts once the user has proved they can read a
   * code from it, which stops a half-finished enrolment locking someone out.
   */
  mfaSecret     String?
  mfaEnabledAt  DateTime?
  mfaRecoveryCodes MfaRecoveryCode[]
  errorLogs           ErrorLog[]
  sessions            Session[]
  tokens              VerificationToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  createdOrders       Order[]             @relation("OrderCreatedBy")
  servedOrders        Order[]             @relation("OrderServedBy")
  receivedPayments    Payment[]           @relation("PaymentReceivedBy")
  refundsIssued       Refund[]            @relation("RefundIssuedBy")
  outgoingCreated     OutgoingPayment[]   @relation("OutgoingPaymentCreatedBy")
  outgoingSubmitted   OutgoingPayment[]   @relation("OutgoingPaymentSubmittedBy")
  outgoingDecided     OutgoingPayment[]   @relation("OutgoingPaymentDecidedBy")
  outgoingPaid        OutgoingPayment[]   @relation("OutgoingPaymentPaidBy")
  accountantNotes     AccountantNote[]    @relation("AccountantNoteAuthor")
  bankStatementsUploaded BankStatement[]  @relation("BankStatementUploadedBy")
  bankLinesMatched    BankStatementLine[] @relation("BankLineMatchedBy")
  stockMovements      StockMovement[]
  shifts              StaffShift[]
  shiftsAdjusted      StaffShift[]        @relation("ShiftAdjustedBy")
  handledRequests     ServiceRequest[]    @relation("RequestHandledBy")
  createdInvites      Invite[]
  accessLinks         Invite[]            @relation("InviteForUser")
  staffRolesCreated   StaffRole[]         @relation("StaffRoleCreatedBy")
  branchId            String?
  /// Short human code a member of staff can be identified by — on a waiter
  /// link, a printed docket, or when an owner asks "who served table 4?".
  /// Unique within a restaurant, never across restaurants.
  staffCode           String?
  /// The code this person signs in with, and the plaintext of their password.
  /// Separate from staffCode on purpose: that one is a sequence and would be
  /// guessable as a credential. Readable by the owner so a lost card can be
  /// reprinted — the same secret is already in that person's pocket.
  signInCode          String?
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierPayments    SupplierPayment[]   @relation("SupplierPaymentBy")
  instructionsGiven   BranchInstruction[] @relation("InstructionAuthor")
  instructionsDone    BranchInstruction[] @relation("InstructionCompleter")
  drawersOpened       CashDrawerSession[] @relation("DrawerOpenedBy")
  drawersClosed       CashDrawerSession[] @relation("DrawerClosedBy")
  drawersReviewed     CashDrawerSession[] @relation("DrawerReviewedBy")
  cashMovements       CashMovement[]      @relation("CashMovementBy")
  pettyRequested      PettyCashRequest[]  @relation("PettyRequestedBy")
  pettyDecided        PettyCashRequest[]  @relation("PettyDecidedBy")
  pettyPaid           PettyCashRequest[]  @relation("PettyPaidBy")
  handoversGiven      CashHandover[]      @relation("HandoverFrom")
  handoversReceived   CashHandover[]      @relation("HandoverTo")
  countsCounted       StockCount[]        @relation("CountCountedBy")
  countsApproved      StockCount[]        @relation("CountApprovedBy")
  recipesCreated      Recipe[]            @relation("RecipeCreatedBy")
  purchasesCreated    Purchase[]          @relation("PurchaseCreatedBy")
  purchasesApproved   Purchase[]          @relation("PurchaseApprovedBy")
  receiptsReceived    GoodsReceipt[]      @relation("ReceiptReceivedBy")
  returnsCreated      PurchaseReturn[]    @relation("ReturnCreatedBy")
  wastageCreated      WastageRecord[]     @relation("WastageCreatedBy")
  wastageApproved     WastageRecord[]     @relation("WastageApprovedBy")
  locationsManaged    Branch[]            @relation("LocationManager")
  transfersRequested  StockTransfer[]     @relation("TransferRequestedBy")
  transfersApproved   StockTransfer[]     @relation("TransferApprovedBy")
  transfersDispatched StockTransfer[]     @relation("TransferDispatchedBy")
  transfersReceived   StockTransfer[]     @relation("TransferReceivedBy")
  productionRequested ProductionOrder[]   @relation("ProductionRequestedBy")
  productionApproved  ProductionOrder[]   @relation("ProductionApprovedBy")
  approvalsRequested  ApprovalRequest[]   @relation("ApprovalRequestedBy")
  approvalsDecided    ApprovalRequest[]   @relation("ApprovalDecidedBy")
  kitchenStations     KitchenStationStaff[]

  @@unique([email])
  @@unique([restaurantId, staffCode])
  @@index([restaurantId, role])
  @@index([restaurantId, staffRoleId])
  @@index([restaurantId, isActive])
  @@index([restaurantId, branchId])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token — the raw token is never stored
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  /**
   * Lineage. Set ONLY when this row was revoked by rotation, naming the row
   * that replaced it.
   *
   * This is what lets a refresh tell "just rotated by a sibling request" from
   * "revoked because the user logged out": the first has a successor, the
   * second does not. Without it, two tabs refreshing at once made the loser
   * delete the winner's brand-new cookie and send the user to the login screen
   * with a live session still in this table.
   *
   * No relation and no index on purpose: a successor is fetched by primary
   * key, and a future purge must be free to delete old rows without nulling
   * anything.
   */
  replacedById     String?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// A role the restaurant defined for itself.
///
/// `UserRole` is a Prisma enum and always will be — `ROLE_HOME`, the edge gate
/// in middleware and `visibleBranchIds` all switch on it, and 109 files import
/// the module that does. So a custom role does not replace the enum; it names
/// the built-in it behaves like (`preset`) and carries its own explicit
/// permission list.
///
/// That list is the whole point. `permissionsFor` used to be role defaults ∪
/// per-user grants, which can only ever ADD — there was no way to take the
/// payments screen off a cashier, because the union put it back. Storing the
/// complete set means OFF is expressible, and means nothing has to compute the
/// precedence between a grant list and a deny list on 152 separate call sites.
model StaffRole {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// The built-in this was cloned from. Decides branch semantics, where the
  /// person lands after signing in, and what the edge gate lets through.
  preset UserRole

  /// The complete permission list. Replaces the preset's defaults rather than
  /// adding to them.
  permissions String[] @default([])

  /// The location members of this role work at. Null means the role does not
  /// pin one and the member's own branch decides.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("StaffRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  members User[]   @relation("UserStaffRole")
  invites Invite[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("staff_roles")
}

/// How a share link signs somebody in.
enum InviteMode {
  /// The link opens a login scoped to its role and branch, and the person
  /// enters their email and code. The link alone is not a credential.
  PERSONAL
  /// Opening the link signs the device in. For a kitchen tablet or a counter
  /// screen that reboots and must come straight back up. The link IS the
  /// credential and has to be treated like one.
  SHARED_DEVICE
}

/// Short-lived invite links that create a temporary staff session for a role.
model Invite {
  id           String     @id @default(cuid())
  token        String     @unique
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         UserRole
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  /// PERSONAL asks for an email and code; SHARED_DEVICE signs the device in.
  /// Existing rows are SHARED_DEVICE because that is what they already do.
  mode InviteMode @default(SHARED_DEVICE)

  /// The location this link is for.
  ///
  /// Absent until now, and that was the bug behind "the screen is empty": the
  /// account the link created had no branch, so `visibleBranchIds` returned []
  /// — sees nothing — and every list on every page came back empty with no
  /// error anywhere to explain it.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /// The custom role this link grants, when it is not a plain preset.
  staffRoleId String?
  staffRole   StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)

  /// For PERSONAL links: whose account it signs in to.
  userId String?
  user   User?   @relation("InviteForUser", fields: [userId], references: [id], onDelete: Cascade)

  /// What the owner called it — "Kitchen tablet", "Nadia — Branch 02".
  label String?

  /// So an owner can tell a link nobody has opened from one in daily use.
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  @@index([restaurantId, isActive])
  @@index([restaurantId, branchId])
  @@map("invites")
}

// ─────────────────────────────────────────────────────────────── menu ──────

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  imageUrl    String?
  icon        String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  foods Food[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model Food {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  description String?
  imageUrl    String?

  /// minor units
  price         Int
  /// optional promotional price, minor units; when set and lower, it wins
  discountPrice Int?
  /// food cost, used for profit reporting
  costPrice     Int  @default(0)

  prepTimeMinutes Int        @default(15)
  calories        Int?
  isVeg           Boolean    @default(false)
  spiceLevel      SpiceLevel @default(NONE)
  isAvailable     Boolean    @default(true)
  isRecommended   Boolean    @default(false)
  isPopular       Boolean    @default(false)
  tags            String[]   @default([])
  allergens       String[]   @default([])
  sortOrder       Int        @default(0)

  /// happy-hour pricing (minutes from midnight, restaurant timezone)
  happyHourPrice    Int?
  happyHourStartMin Int?
  happyHourEndMin   Int?
  happyHourDays     Int[] @default([])

  soldCount   Int @default(0)
  ratingSum   Int @default(0)
  ratingCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  variantGroups VariantGroup[]
  orderItems    OrderItem[]
  recipes       Recipe[]
  branches      FoodBranch[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, isPopular])
  @@map("foods")
}

/// Which branches may sell a dish, and what it costs at each.
///
/// The menu used to be one flat list per restaurant: one price, one
/// availability flag, one sort order for every site. A dish added at Main
/// appeared instantly at Kandy, and dropping Kandy's price dropped Main's.
///
/// This is a join table rather than a copy of the dish per branch, and that
/// distinction matters: duplicating would fork the recipe, the photo, the
/// variant groups and the sales history, so "how many burgers did we sell"
/// would need summing across rows that drift apart. One `Food` stays the
/// master; only what differs per site lives here.
///
/// `InventoryStock` is the same shape for stock and is the precedent — except
/// that both columns here are non-null, so a plain `@@unique` works where that
/// model needed partial indexes.
///
/// A row's existence IS the sharing decision. No row means the branch does not
/// have the dish at all — not that it has it and turned it off.
model FoodBranch {
  id           String     @id @default(cuid())
  /// Denormalised so every query can scope by tenant without a second join.
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodId       String
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// null means "use the dish's own price". Set only when this branch differs,
  /// so a restaurant that prices the same everywhere has one number to change.
  price         Int?
  discountPrice Int?
  /// Off here, on elsewhere — distinct from the dish's own `isAvailable`,
  /// which takes it off every menu at once.
  isAvailable   Boolean @default(true)
  /// Overrides the dish's own order on this branch's menu.
  sortOrder     Int?

  /// Which kitchen station cooks this dish AT THIS BRANCH.
  ///
  /// Per branch and not per dish, because the same pizza can come off a
  /// dedicated Pizza Station at one site and the main kitchen at another. Null
  /// means unmapped, which blocks the kitchen from accepting an order
  /// containing it — unless `noKitchenRequired` says it never needed cooking.
  stationId         String?
  station           KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  /// Bottled water, packaged snacks — things that come off a shelf. They skip
  /// kitchen routing entirely and are ready the moment the order is accepted.
  noKitchenRequired Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foodId, branchId])
  @@index([restaurantId, branchId, isAvailable])
  @@index([branchId])
  @@index([stationId])
  @@map("food_branches")
}

/// A sellable bundle of features, owned by the platform operator.
///
/// Not per restaurant and not hardcoded: `superadmin.md` is explicit that the
/// operator creates and edits these himself. Applying one copies its keys onto
/// the restaurant, so a later edit to the package does not silently re-scope
/// every tenant already on it.
model FeaturePackage {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  /// Feature keys from `src/features/access/features.ts`.
  featureKeys String[] @default([])
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants Restaurant[]

  @@map("feature_packages")
}

/// A section of a kitchen: the rice range, the pizza oven, the juice bar.
///
/// Branch-scoped, because two sites rarely have the same sections and an order
/// taken at one must never appear on another's screen. Names are the owner's
/// own — nothing here is hardcoded.
model KitchenStation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Order the stations appear in, on the setup screen and the supervisor view.
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  /// Free text naming the printer this station's tickets go to, for restaurants
  /// that print. Nothing routes on it yet.
  printerName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff      KitchenStationStaff[]
  menu       FoodBranch[]
  orderItems OrderItem[]

  @@unique([branchId, name])
  @@index([restaurantId, branchId, isActive])
  @@map("kitchen_stations")
}

/// Which cooks work which station.
///
/// `User.branchId` confines someone to a site and nothing finer, so this is the
/// only way to say "Chef A is on the rice range". A cook with NO rows sees every
/// station at their branch — fail-open here on purpose, because the alternative
/// is that a newly added cook sees nothing and cannot work.
model KitchenStationStaff {
  id        String         @id @default(cuid())
  stationId String
  station   KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([stationId, userId])
  @@index([userId])
  @@map("kitchen_station_staff")
}

model VariantGroup {
  id     String @id @default(cuid())
  foodId String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  name       String
  kind       VariantKind @default(VARIANT)
  isRequired Boolean     @default(false)
  minSelect  Int         @default(0)
  maxSelect  Int         @default(1)
  sortOrder  Int         @default(0)

  options VariantOption[]

  @@index([foodId])
  @@map("variant_groups")
}

model VariantOption {
  id      String       @id @default(cuid())
  groupId String
  group   VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name        String
  /// price delta in minor units; may be negative
  priceDelta  Int     @default(0)
  isDefault   Boolean @default(false)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  /// What choosing this option consumes — "extra chicken" is food leaving the
  /// kitchen, and for as long as this was missing it left silently (§29).
  /// Null means the option is free of stock (e.g. "no onions"), which is a
  /// real state, not a default to fear.
  recipeId String?
  recipe   Recipe? @relation("OptionConsumption", fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([recipeId])
  @@map("variant_options")
}

// `RecipeItem` lived here: a second, flat recipe table edited from a tab inside
// the menu item dialog. It was silently ignored whenever a versioned `Recipe`
// existed for the same dish — so an owner could type ingredients in, watch them
// save, and see stock move by different numbers. Its rows were migrated into
// `Recipe` by 20260912090000_recipes_and_production_merge. The `recipe_items`
// table is deliberately left in the database for one release; nothing reads it.

// ────────────────────────────────────────────────────────────── floor ──────

model RestaurantTable {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  number    String
  label     String?
  area      String?     @default("Main")
  capacity  Int         @default(4)
  status    TableStatus @default(AVAILABLE)
  notes     String?
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  reservations    Reservation[]
  serviceRequests ServiceRequest[]
  /// Required. A table stands in one building; "Table 4" at Kandy and "Table 4"
  /// at Colombo are different tables, and a QR that cannot say which is a QR
  /// that sends the order to the wrong kitchen. Nullable until now, and never
  /// written by any screen — every row was back-filled to its restaurant's
  /// default branch by the migration that made this required.
  branch          Branch           @relation(fields: [branchId], references: [id])
  branchId        String

  /// Numbers restart per branch, which is why this is not [restaurantId, number].
  sessions TableSession[]
  @@unique([restaurantId, branchId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, branchId])
  @@map("restaurant_tables")
}

// ─────────────────────────────────────────────────────────── customers ─────

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?
  notes String?

  loyaltyPoints      Int           @default(0)
  /// lifetime spend, minor units
  totalSpent         Int           @default(0)
  totalOrders        Int           @default(0)
  lastOrderAt        DateTime?
  isBlocked          Boolean       @default(false)
  group              CustomerGroup @default(GENERAL)
  /// Explicit opt-in to marketing. Absent means no — consent is never assumed,
  /// and `marketingConsentAt` records when it was actually given.
  marketingConsent   Boolean       @default(false)
  marketingConsentAt DateTime?
  birthday           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  reservations   Reservation[]
  reviews        Review[]
  redemptions    CouponRedemption[]
  loyaltyEntries LoyaltyEntry[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastOrderAt])
  @@map("customers")
}

// ────────────────────────────────────────────────────────────── orders ─────

model Order {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orderNumber   String
  type          OrderType     @default(DINE_IN)
  /// How the order reached the system; see OrderChannel.
  channel       OrderChannel  @default(STAFF)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  tableId     String?
  table       RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// The table number as it was when the order was taken.
  ///
  /// `tableId` is SetNull, so deleting a table erased which table every past
  /// order had been at — twenty-five screens read `order.table?.number` and all
  /// of them went blank. A number is also a display value that a restaurant may
  /// renumber; the bill should say what the guest saw, not what the floor plan
  /// says today. Null for takeaway, delivery and counter sales, which have no
  /// table — a real state, not a missing one.
  tableNumber String?
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// snapshot so the ticket stays correct even if the customer record changes
  customerName  String
  customerPhone String
  customerEmail String?

  /// anonymous browser session that placed the order — used to authorise
  /// guest access to tracking/billing without an account
  guestSessionId String?

  createdById String?
  /// Whose table this is. Distinct from createdById, which is whoever keyed the
  /// order in — a cashier ringing up a waiter's table is the normal case, and
  /// collapsing the two would credit the till instead of the person serving.
  servedById  String?
  servedBy    User?   @relation("OrderServedBy", fields: [servedById], references: [id], onDelete: SetNull)
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // ── money, all minor units ───────────────────────────────
  subtotal        Int @default(0)
  /// couponDiscount + manualDiscount, kept because every report reads it.
  /// The two columns underneath are the truth; this is their sum, always.
  discountTotal   Int @default(0)
  couponDiscount  Int @default(0)
  manualDiscount  Int @default(0)
  loyaltyDiscount Int @default(0)
  taxTotal        Int @default(0)
  serviceCharge   Int @default(0)
  tipAmount       Int @default(0)
  roundingAdj     Int @default(0)
  grandTotal      Int @default(0)
  paidTotal       Int @default(0)

  taxRateBps       Int @default(0)
  serviceChargeBps Int @default(0)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  notes            String?
  cancelReason     String?
  estimatedMinutes Int     @default(0)
  guestCount       Int?

  /// Parked at the counter so the cashier can serve someone else and come back.
  /// A held bill stays out of the active queue but is never cancelled.
  heldAt     DateTime?
  holdReason String?

  /// Split lineage — this bill was created by splitting `splitFrom`.
  splitFromId String?
  splitFrom   Order?  @relation("OrderSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splits      Order[] @relation("OrderSplit")

  /// Merge lineage — this bill's items moved into `mergedInto`, and it was
  /// closed. Kept rather than deleted so the day's history stays auditable.
  mergedIntoId String?
  mergedInto   Order?  @relation("OrderMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Order[] @relation("OrderMerge")

  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  refunds        Refund[]
  invoice        Invoice?
  review         Review?
  redemptions    CouponRedemption[]
  stockMovements StockMovement[]
  depletions     OrderStockDepletion[]
  /// Required. 426 of 434 orders had no branch before this: the guest path
  /// never passed one and the staff path passed `user.branchId ?? null`, which
  /// is null for an owner. Since every branch filter is `branchId IN (…)` and
  /// `NULL IN (…)` is never true, selecting a location made almost every order
  /// vanish from sales and profit. Now the database refuses a branchless order,
  /// so no code path can quietly skip it again.
  branch         Branch                @relation(fields: [branchId], references: [id])
  branchId       String

  /// How urgently the kitchen should treat this order.
  ///
  /// On the ORDER and not on its items: a rush is a property of the table
  /// waiting, not of one dish, and per-item priority would make the audit
  /// trail's before/after ambiguous. Stations sort by priority, then by how
  /// long the item has been waiting.
  priority       OrderPriority         @default(NORMAL)

  /// Deduplicates a resubmitted order.
  ///
  /// The client sends one id per cart. A double tap, a flaky connection retry or
  /// a replayed request therefore lands on the same key and the second insert
  /// loses to this constraint, so the guest gets the order they already have
  /// rather than a second one — which would otherwise deduct the ingredients
  /// twice. Partial so the column can stay null for orders keyed in by staff.
  idempotencyKey String?

  @@unique([restaurantId, orderNumber])
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, placedAt])
  @@index([restaurantId, paymentStatus])
  @@index([restaurantId, placedAt])
  /// Lets /api/pulse read MAX("updatedAt") per restaurant as an index scan.
  /// Every station polls that, so it has to stay O(1) as history grows.
  @@index([restaurantId, updatedAt])
  @@index([restaurantId, tableId, status])
  @@index([customerId])
  /// "Their previous completed visit" — the live board asks this for every
  /// seated customer at once. `[customerId]` alone made it read every order a
  /// regular has ever placed, filter the status on the heap and then sort.
  @@index([customerId, status, placedAt])
  @@index([guestSessionId])
  @@index([restaurantId, heldAt])
  @@index([restaurantId, branchId, placedAt])
  @@map("orders")
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodId  String?
  food    Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  /// immutable snapshots — the menu may change after the order is placed
  name            String
  imageUrl        String?
  unitPrice       Int
  quantity        Int             @default(1)
  /// The exact recipe version this line was depleted and costed against.
  recipeId        String?
  recipe          Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// [SelectedOption[]] — [{ groupId, groupName, optionId, name, priceDelta, kind }]
  options         Json?
  optionsTotal    Int             @default(0)
  lineTotal       Int
  costPrice       Int             @default(0)
  notes           String?
  status          OrderItemStatus @default(QUEUED)
  isVeg           Boolean         @default(false)
  prepTimeMinutes Int             @default(0)

  /// ── kitchen routing — MUTABLE BY DESIGN ────────────────────────────────
  ///
  /// Deliberately outside the immutable-snapshot block above. A supervisor may
  /// move a pending item to another station when one goes down, so these change
  /// after the order is placed; applying the immutability rule here would make
  /// that reassignment impossible.
  ///
  /// The station this item is cooked at. Null means either "not routed yet" or
  /// "needs no kitchen" — `routedAt` is what tells those apart.
  stationId   String?
  station     KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  /// The station's name at the time. Snapshotted for the same reason
  /// `Order.tableNumber` is: a station may be renamed or deleted, and the
  /// per-station reports still have to be readable afterwards.
  stationName String?

  /// When the kitchen accepted the order and this item was assigned a station.
  ///
  /// This is also the flag that decides whether the order runs in station mode.
  /// A set of items with any `routedAt` is driven UP from its items; a set with
  /// none is cascaded DOWN from the order, exactly as before stations existed.
  /// Per-order rather than per-restaurant, so an order taken before the owner
  /// created their first station keeps its original behaviour for life.
  routedAt    DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([foodId])
  @@index([orderId, status])
  @@index([stationId, status])
  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model ServiceRequest {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  type        ServiceRequestType
  status      ServiceRequestStatus @default(OPEN)
  note        String?
  handledById String?
  handledBy   User?                @relation("RequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())

  @@index([restaurantId, status, createdAt])
  @@map("service_requests")
}

// ──────────────────────────────────────────────── payments & billing ───────

model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method         PaymentMethod
  status         PaymentStatus @default(UNPAID)
  amount         Int
  tenderedAmount Int?
  changeAmount   Int           @default(0)

  /// gateway / UPI reference
  reference     String?
  gateway       String?
  gatewayRef    String?
  /// intent identifier for dynamic QR payments
  intentId      String? @unique
  qrPayload     String?
  failureReason String?

  receivedById String?
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  /// Retry safety for money coming in.
  ///
  /// The order row is locked while a capture runs, which stops two taps landing
  /// at the same instant. It does NOT stop the other shape of double-take: the
  /// request that committed and then lost its response, so the till retries a
  /// capture that already happened and books the money twice. The client mints
  /// one id per tender attempt and reuses it across retries, so the replay
  /// finds the payment it already made instead of making another. Partial so
  /// the column stays null for the paths that predate it.
  clientRequestId String?

  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  cashDrawerSession   CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id])
  cashDrawerSessionId String?
  /// The drawer movement a refund of this payment produced, if it produced one.
  cashMovements       CashMovement[]
  refunds             Refund[]

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId, status, createdAt])
  @@index([orderId])
  @@map("payments")
}

/**
 * Money going back. A payment is a fact — it happened, and editing it is how
 * books stop balancing — so a refund is its own row: how much of which payment
 * went back, when, why, and on whose authority. Partial refunds are several
 * rows against one payment; the payment flips to REFUNDED only when the sum
 * of its refunds covers it.
 */
model Refund {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Int
  /// How the money went back — normally the method it arrived by.
  method PaymentMethod
  reason String

  refundedById String?
  refundedBy   User?   @relation("RefundIssuedBy", fields: [refundedById], references: [id], onDelete: SetNull)

  /// Retry safety for money going out — the same reasoning as
  /// `Payment.clientRequestId`, and it matters more here, because the failure
  /// mode is handing the cash back twice.
  clientRequestId String?

  createdAt DateTime @default(now())

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

/**
 * Why a loyalty balance is what it is (§72).
 *
 * `Customer.loyaltyPoints` used to be a bare number three code paths
 * incremented and decremented — no history, no way to answer "where did this
 * guest's points go". Every earn, spend and give-back is a signed row now;
 * the balance column stays as the cached sum because every screen reads it,
 * and the opening state was captured as one ADJUSTED entry per customer so
 * sum(entries) equals the balance from the first day.
 */
model LoyaltyEntry {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The order that caused it, when one did.
  orderId      String?

  /// Signed: earns positive, spends negative.
  points Int
  kind   LoyaltyEntryKind
  note   String?

  actorId   String?
  createdAt DateTime @default(now())

  @@index([restaurantId, customerId, createdAt])
  @@index([orderId])
  @@map("loyalty_entries")
}

/**
 * Named counters, one row per (restaurant, key) — e.g. `invoice:2026`.
 *
 * Invoice numbers used to come from `count(*) this year + 1`, which two
 * simultaneous settlements both compute identically: one bill settles, the
 * other dies on the unique constraint. An atomic upsert-increment cannot
 * collide and never reuses a number, even for deleted invoices.
 */
/**
 * Fixed-window rate-limit counters, shared across serverless instances.
 * Redis serves this where configured; on hosts without it the in-memory
 * fallback counted per instance — which on a per-request serverless platform
 * is counting to one, i.e. no limit at all. Rows are transient and swept
 * opportunistically.
 */
/**
 * Every print, on the record (§80). Printing happens in the browser and used
 * to be fire-and-forget: a receipt that never came out left no trace, and
 * "print it again" meant reconstructing the bill by hand. Each attempt lands
 * here with the exact payload that was rendered, so a reprint is the SAME
 * document — not a fresh one that might differ — and a failed print is a row
 * somebody can see, not a shrug.
 */
model PrintJob {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  orderId      String?

  kind     PrintJobKind
  status   PrintJobStatus @default(PRINTED)
  attempts Int            @default(1)
  /// The rendered receipt, verbatim — what reprint reproduces.
  payload  Json

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@map("print_jobs")
}

model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit_counters")
}

model RestaurantCounter {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  key          String
  value        Int    @default(0)

  @@id([restaurantId, key])
  @@map("restaurant_counters")
}

/**
 * The accountant's book of formal expense categories — rent, utilities,
 * salaries. A real model, not a free-text field: reports group by it, and a
 * typo is not a category. Petty cash deliberately keeps its own small
 * free-text vocabulary for drawer money; these are the books.
 */
model ExpenseCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  payments OutgoingPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive, sortOrder])
  @@map("expense_categories")
}

/**
 * Money leaving the business, with a life: DRAFT → SUBMITTED → APPROVED or
 * REJECTED (owner's pen, never the submitter's) → PAID → possibly REVERSED.
 *
 * Its own model, deliberately — the codebase has ruled three times that a
 * request with a life after approval does not fit ApprovalRequest ("has no
 * vocabulary for it"; see PettyCashRequest). Only the rule worth borrowing is
 * borrowed: the approver is never the requester.
 *
 * A PAID row is immutable. kind SUPPLIER creates the ordinary
 * SupplierPayment ledger row at payment time (the supplier balance math and
 * its pinned tests never change); kind EXPENSE IS the expense record.
 * Corrections are reversal rows linked by `reversalOfId`, never edits.
 */
model OutgoingPayment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// OP-<year>-<seq> from the named counter — the reference a supplier or an
  /// auditor quotes back. Never reused, even for cancelled drafts.
  number String

  kind   OutgoingPaymentKind
  status OutgoingPaymentStatus @default(DRAFT)

  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// The bill being settled, when the payment answers a specific PO — also
  /// how the projected SupplierPayment reaches a branch.
  purchaseId        String?
  purchase          Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  /// Minor units, immutable once submitted — corrections reverse, never edit.
  amount      Int
  method      PaymentMethod @default(CASH)
  reference   String?
  description String
  /// When the money moves. assertPeriodOpen refuses a date inside a sealed
  /// accounting period.
  paymentDate DateTime

  createdById   String?
  createdBy     User?     @relation("OutgoingPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Denormalised like SupplierPayment.createdByName: a departed user must
  /// not erase who moved the money.
  createdByName String
  submittedById String?
  submittedBy   User?     @relation("OutgoingPaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?
  decidedById   String?
  decidedBy     User?     @relation("OutgoingPaymentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  paidById      String?
  paidBy        User?     @relation("OutgoingPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt        DateTime?

  /// The SupplierPayment ledger row this projected at payment time (kind
  /// SUPPLIER). The supplier balance math never changed; this is the trace.
  supplierPaymentId String?          @unique
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)

  /// Set on a reversal row: the PAID payment it negates. Unique — one
  /// reversal per payment, enforced by the database, not by discipline.
  reversalOfId String?          @unique
  reversalOf   OutgoingPayment? @relation("OutgoingPaymentReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversal     OutgoingPayment? @relation("OutgoingPaymentReversal")

  cashMovements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId, branchId, status, createdAt])
  @@index([restaurantId, kind, status, paymentDate])
  @@index([restaurantId, supplierId, paymentDate])
  @@index([restaurantId, expenseCategoryId, paymentDate])
  @@map("outgoing_payments")
}

/**
 * One sitting at one table (§TableSession). Orders come and go over a meal —
 * a starter round, more drinks, a split for the bill — and until this existed
 * nothing tied them together: "what does table 4 owe" was a query over open
 * orders with no notion of when the sitting began or ended. A session opens
 * with the first dine-in order at a free table and closes when the table
 * finally clears. Historical orders keep a null session; sittings cannot be
 * honestly reconstructed after the fact.
 */
model TableSession {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  status     TableSessionStatus @default(OPEN)
  guestCount Int?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  orders Order[]

  @@index([restaurantId, tableId, status])
  @@index([restaurantId, openedAt])
  @@map("table_sessions")
}

/**
 * A business day, signed off (§50–51). Closing a day freezes the accountant's
 * daily report — sales, payments by method, refunds, drawer variances, COGS —
 * as a snapshot nothing can rewrite, and records who signed it. One row per
 * restaurant per local business date; branch-level closes use branchId.
 */
model DailyClose {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?

  /// The LOCAL business date being closed, as midnight UTC of that date.
  businessDate DateTime
  closedById   String?
  closedAt     DateTime @default(now())
  notes        String?
  /// [DailyCloseSnapshot] — the §51 daily report, frozen at sign-off.
  snapshot     Json

  /// NB: NULL branchIds are distinct to this unique, so it cannot by itself
  /// stop two restaurant-level closes for one date. A PARTIAL unique index
  /// (20260915120000, WHERE branchId IS NULL) closes that case — invisible
  /// to Prisma's diff, same precedent as the order idempotency index.
  @@unique([restaurantId, branchId, businessDate])
  @@index([restaurantId, businessDate])
  @@map("daily_closes")
}

/**
 * A range of business the books consider settled (§59). While a period is
 * CLOSED, the orders inside it refuse cancellation, voids, discount edits and
 * guest changes — the numbers were signed; changing them needs the period
 * reopened, on the record.
 */
model AccountingPeriod {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  status      AccountingPeriodStatus @default(CLOSED)
  closedById  String?
  closedAt    DateTime @default(now())
  reopenedById String?
  reopenedAt   DateTime?
  notes       String?

  @@index([restaurantId, periodStart, periodEnd])
  @@map("accounting_periods")
}

model Invoice {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  number    String
  issuedAt  DateTime  @default(now())
  emailedAt DateTime?
  pdfUrl    String?
  /// [InvoiceSnapshot] — frozen copy of the bill at issue time
  snapshot  Json

  @@unique([restaurantId, number])
  @@index([restaurantId, issuedAt])
  @@map("invoices")
}

model Coupon {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  code             String
  description      String?
  type             CouponType     @default(PERCENT)
  /// PERCENT → basis points, FIXED → minor units
  value            Int
  minOrderAmount   Int            @default(0)
  maxDiscount      Int?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usedCount        Int            @default(0)
  perCustomerLimit Int?
  scope            DiscountScope  @default(BILL)
  /// [String[]] — food ids this applies to, when scope is ITEM.
  itemIds          Json?
  /// [String[]] — category ids, when scope is CATEGORY.
  categoryIds      Json?
  /// Confine an offer to one location.
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Hours of the day the offer runs, 0-23. Null means any time. Used for
  /// happy hour, where an all-day discount would be a costly mistake.
  startHour        Int?
  endHour          Int?
  /// [Int[]] — days of the week, 0 = Sunday. Null means every day.
  daysOfWeek       Json?
  /// Restrict to a customer segment.
  customerGroup    CustomerGroup?
  isActive         Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@index([restaurantId, branchId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount     Int
  createdAt  DateTime  @default(now())

  @@unique([couponId, orderId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────────────────────────────────── inventory ─────

model Supplier {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  /// Registered company name, when it differs from the trading name.
  company     String?
  contactName String?
  phone       String?
  email       String?
  address     String?

  paymentTerms     PaymentTerms @default(COD)
  /// Free text for CUSTOM terms, e.g. "half on delivery, half in 30 days".
  paymentTermsNote String?
  /// Tax registration number, printed on purchase paperwork.
  taxNumber        String?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         InventoryItem[]
  purchases     Purchase[]
  suppliedItems SupplierItem[]
  returns       PurchaseReturn[]
  payments      SupplierPayment[]
  priceHistory  PurchasePriceHistory[] @relation("PriceHistorySupplier")

  outgoingPayments OutgoingPayment[]
  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("suppliers")
}

model InventoryItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  sku         String?
  barcode     String?
  category    String?
  /// The managed category, when one has been chosen. `category` above is kept
  /// in step as a fallback so every existing reader keeps working.
  categoryId  String?
  categoryRef InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// The unit the ledger is kept in. Every movement is converted to this
  /// before it is posted, so a balance is never a mix of kg and grams.
  unit                 StockUnit  @default(PIECE)
  /// How the supplier sells it, e.g. BOX. Converted on receipt.
  purchaseUnit         StockUnit?
  /// How a recipe draws it down, e.g. GRAM. Converted on consumption.
  consumptionUnit      StockUnit?
  /// Base units in one purchase unit — "1 box = 10 kg" is 10 when the base
  /// unit is KG. Only needed when the conversion is not a standard one
  /// (kg↔g, litre↔ml, dozen↔piece are known); a box or packet is whatever
  /// this restaurant's supplier says it is.
  unitsPerPurchaseUnit Float?

  /// Cached balance. The ledger is the source of truth; this is derived from
  /// it on every post and must never be written to directly.
  quantity     Float  @default(0)
  reorderLevel Float  @default(0)
  minStock     Float  @default(0)
  /// Par level. Above this the item is flagged as overstocked.
  maxStock     Float?

  /// Weighted average cost per base unit, minor units. Recomputed on receipt.
  /// A CACHE of stockValue / quantity, rounded — display and fallback only.
  costPerUnit      Int  @default(0)
  /// What the stock on hand is WORTH, minor units, exact. The ledger moves
  /// this with every movement: receipts add at their price, issues subtract
  /// at the running average, and the pennies that per-unit rounding used to
  /// bleed on every movement stay in here (§39 — value-carrying WAC).
  stockValue       Decimal @default(0) @db.Decimal(18, 6)
  /// What the last purchase actually cost per base unit, minor units.
  lastPurchaseCost Int?

  trackExpiry  Boolean          @default(false)
  trackBatches Boolean          @default(false)
  /// Draw the oldest-expiring batch first. Opt-in per item — most stock
  /// does not need it, and forcing it everywhere makes ordinary receiving
  /// slower for no benefit.
  useFefo      Boolean          @default(false)
  expiryDate   DateTime?
  storageArea  String?
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive     Boolean          @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements          StockMovement[]
  producedBy         Recipe[]                @relation("RecipeProduces")
  recipeUsages       RecipeIngredient[]
  depletions         OrderStockDepletion[]
  supplierItems      SupplierItem[]
  receiptLines       GoodsReceiptLine[]
  returnLines        PurchaseReturnLine[]
  priceHistory       PurchasePriceHistory[]
  batches            StockBatch[]
  wastageRecords     WastageRecord[]
  locationStock      InventoryStock[]
  transferLines      StockTransferLine[]
  productionConsumed ProductionConsumption[]
  productionOutputs  ProductionOutput[]
  /// Runs that produced this item (redesignkitchenjob.md).
  producedRuns       ProductionOrder[]       @relation("ProducedItem")
  /// Made here rather than bought. Set the first time a production run outputs
  /// this item and never cleared; the Prepared Items tab is this flag. Backfilled
  /// from production_outputs and prep recipes in 20260918090000_prepared_items.
  isPrepared         Boolean                 @default(false)
  producedBySpec     ProductionSpec[]        @relation("ProductionSpecOutput")
  specIngredients    ProductionSpecItem[]
  purchaseItems      PurchaseItem[]
  branch             Branch?                 @relation(fields: [branchId], references: [id])
  branchId           String?

  stockCountLines StockCountLine[]

  @@unique([restaurantId, name])
  /// Two items sharing a SKU is how the wrong thing gets scanned out.
  @@unique([restaurantId, sku])
  @@index([restaurantId, isActive])
  @@index([restaurantId, expiryDate])
  @@index([restaurantId, branchId, isActive])
  @@index([restaurantId, supplierId])
  @@index([restaurantId, categoryId])
  @@map("inventory_items")
}

model StockMovement {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type            StockMovementType
  /// Signed and always in the item's base unit: positive adds, negative removes.
  quantity        Float
  /// What the user actually entered, before conversion — kept so the ledger can
  /// show "500 g" rather than "0.5" when the base unit is kg.
  quantityEntered Float?
  enteredUnit     StockUnit?
  /// Running balance in base units immediately after this row was posted.
  /// Written inside the same transaction that moves the stock, so the ledger
  /// explains itself without replaying every earlier row.
  balanceAfter    Float?
  unitCost        Int               @default(0)
  reason          String?
  notes           String?

  /// What caused this movement — 'Purchase', 'Order', 'StockCount',
  /// 'Transfer' — plus the id of that record, so every row is traceable back
  /// to its source.
  referenceType String?
  referenceId   String?

  batchNo    String?
  batchId    String?
  batch      StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  expiryDate DateTime?

  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stockCountId String?
  stockCount   StockCount?      @relation(fields: [stockCountId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId   String?
  purchase     Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([itemId, createdAt])
  @@index([restaurantId, type, createdAt])
  @@index([referenceType, referenceId])
  @@index([restaurantId, branchId, createdAt])
  @@index([itemId, branchId, createdAt])
  @@index([orderId])
  @@index([purchaseId])
  @@map("stock_movements")
}

model Purchase {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  number String
  status PurchaseStatus @default(DRAFT)

  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locationId String?
  location   StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// Money, all in minor units. Subtotal is the sum of the lines; discount and
  /// tax are order-level and applied after, matching how a supplier invoice
  /// reads.
  subtotal Int @default(0)
  discount Int @default(0)
  taxTotal Int @default(0)
  total    Int @default(0)

  notes      String?
  expectedAt DateTime?
  orderedAt  DateTime?
  receivedAt DateTime?

  createdById  String?
  createdBy    User?     @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   User?     @relation("PurchaseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseItem[]
  movements StockMovement[]
  receipts  GoodsReceipt[]
  returns   PurchaseReturn[]
  payments  SupplierPayment[]

  outgoingPayments OutgoingPayment[]
  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, supplierId, createdAt])
  @@index([restaurantId, branchId])
  @@map("purchases")
}

model PurchaseItem {
  id         String        @id @default(cuid())
  purchaseId String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Ordered quantity, in `unit`.
  quantity  Float
  unit      StockUnit?
  /// Cost per `unit`, minor units.
  unitCost  Int
  lineTotal Int

  /// Running totals maintained as goods arrive, both in the line's own unit.
  receivedQty Float @default(0)
  rejectedQty Float @default(0)

  receiptLines GoodsReceiptLine[]

  @@index([purchaseId])
  @@index([itemId])
  @@map("purchase_items")
}

// ──────────────────────────────────────────── reservations & feedback ──────

model Reservation {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Which site the booking is for.
  ///
  /// Nullable only so existing rows survive the migration — everything written
  /// from now on carries one. A guest books a table at a place, not at a
  /// company, and without this a Kandy manager saw Colombo's diary and could
  /// seat somebody at a Colombo table from it.
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tableId      String?
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName    String
  customerPhone   String
  customerEmail   String?
  partySize       Int               @default(2)
  reservedAt      DateTime
  durationMinutes Int               @default(90)
  status          ReservationStatus @default(PENDING)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, reservedAt])
  @@index([restaurantId, status])
  @@index([restaurantId, branchId, reservedAt])
  @@map("reservations")
}

model Review {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  rating        Int
  foodRating    Int?
  serviceRating Int?
  comment       String?
  reply         String?
  repliedAt     DateTime?
  isPublished   Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@map("reviews")
}

/// Anonymous one-tap guest feedback — no personal details, so guests actually leave it.
model Feedback {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  category FeedbackCategory @default(FOOD)

  /// 1 = unhappy 😞 … 4 = delighted 😍
  rating      Int
  comment     String?
  tableNumber String?
  createdAt   DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([category, createdAt])
  @@map("feedback")
}

/// Digital shift handover — notes one manager leaves for the next shift.
/// An owner's standing instruction for one location, and the manager's answer.
///
/// Added because there was no way for an owner to tell a branch anything. They
/// could see the branch's numbers and move its stock, and then had to pick up
/// the phone — so the app held the facts and WhatsApp held the decisions, and
/// nobody could tell later whether a thing had actually been done.
///
/// Deliberately not a message: a message is read and forgotten. This has a
/// state, an optional due date, and a name against the completion, so "did
/// Kandy ever do the stock count I asked for" has an answer on a screen.
model BranchInstruction {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// The location it is for. Null means every location — a group-wide notice.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  title String
  body  String?

  priority InstructionPriority @default(NORMAL)
  status   InstructionStatus   @default(OPEN)
  dueAt    DateTime?

  createdById   String?
  createdBy     User?   @relation("InstructionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String

  doneById   String?
  doneBy     User?     @relation("InstructionCompleter", fields: [doneById], references: [id], onDelete: SetNull)
  doneByName String?
  doneAt     DateTime?
  doneNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, branchId, status])
  @@map("branch_instructions")
}

enum InstructionPriority {
  NORMAL
  URGENT
}

enum InstructionStatus {
  OPEN
  DONE
  CANCELLED
}

/// A stock unit the owner can name, label, order and switch off.
///
/// `StockUnit` stays an enum and stays the column type everywhere, because the
/// conversion engine in `features/inventory/units.ts` encodes facts — 1 kg is
/// 1000 g — that guard every ledger row. Putting those in a form field would
/// put the correctness of the stock ledger in the hands of a typo.
///
/// What this table governs is presentation and availability: what a unit is
/// called, what symbol prints on a docket, what order the dropdowns list them
/// in, and whether a unit is offered at all. A restaurant that never sells by
/// the dozen turns Dozen off and stops scrolling past it forty times a day.
///
/// Deactivating never touches stock. Existing items keep their unit and every
/// historical movement still reads correctly; the unit simply stops being
/// offered for new ones.
model Unit {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// The enum member this row describes. One row per member, seeded on demand.
  code   StockUnit
  /// What to call it in a dropdown — "Kilogram".
  name   String
  /// What to print beside a number — "kg".
  symbol String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("units")
}

/// A stock category — Rice, Meat, Cleaning, Packaging.
///
/// `InventoryItem.category` was free text, so "Dairy" and "dairy" were two
/// silent buckets and no screen could offer the list back. The string column
/// stays as a fallback and is kept in step, so nothing that reads it breaks and
/// an item can never be orphaned by a category being retired.
model InventoryCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  items InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("inventory_categories")
}

/// Money paid to a supplier.
///
/// The one thing missing before a supplier ledger could exist. Purchases and
/// receipts were recorded, and there was no way anywhere in the system to say
/// "we paid ABC Distributors 30,000" — so "what do we owe" had no answer, and
/// `Supplier.paymentTerms` was stored, displayed, and drove nothing.
///
/// A payment may be attached to one order, or left general — a lump sum against
/// an account is how most small suppliers are actually settled, and forcing it
/// onto an invoice would make people invent an allocation that never happened.
///
/// The BALANCE is never stored. It is computed from the documents each time it
/// is read: received value owed, less payments and returns. A stored balance is
/// a second source of truth that drifts from the first, which is the bug class
/// that has cost this project the most time.
model SupplierPayment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Optional — settles one specific order rather than the account generally.
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  /// Minor units, like every other money column here.
  amount    Int
  method    PaymentMethod @default(CASH)
  /// Cheque number, transfer reference, receipt number.
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())

  createdById   String?
  createdBy     User?   @relation("SupplierPaymentBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Kept beside the id so a departed member of staff cannot erase who paid.
  createdByName String

  createdAt DateTime @default(now())

  outgoingPayment OutgoingPayment?
  @@index([restaurantId, supplierId, paidAt])
  @@index([restaurantId, paidAt])
  @@map("supplier_payments")
}

model ShiftNote {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// The site the note was written at.
  ///
  /// It had no branch at all, and `listShiftNotes` filtered on the restaurant
  /// alone — so a note left by the closing cashier at Branch 01 appeared on
  /// Main Branch's handover screen, which is the bug that started this. A
  /// handover is the most site-specific thing in the building: it is one shift
  /// telling the next shift, in the same room, what happened.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  body       String
  authorId   String?
  authorName String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([restaurantId, resolved, createdAt])
  @@index([restaurantId, branchId, resolved, createdAt])
  @@map("shift_notes")
}

// ─────────────────────────────────────────── ops: notify / audit / hr ──────

model Notification {
  id           String                @id @default(cuid())
  restaurantId String
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience     NotificationAudience?

  /// Which site this concerns. NULL is meaningful and stays allowed: it is a
  /// genuine group-wide announcement, and readers include nulls rather than
  /// filtering them out. Everything driven by an order, a table or a drawer
  /// carries the branch, so a Branch 01 ticket no longer rings Main's bell.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  type   NotificationType
  title  String
  body   String?
  /// [NotificationData] — { orderId, orderNumber, tableNumber, amount, ... }
  data   Json?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([userId, readAt])
  @@index([restaurantId, branchId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorName String?
  action    String
  entity    String
  entityId  String?
  /// [AuditDiff]
  before    Json?
  /// [AuditDiff]
  after     Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  branchId  String?

  @@index([restaurantId, createdAt])
  @@index([entity, entityId])
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, action, createdAt])
  /// "Everything this person did between these two times" — the staff activity
  /// feed. None of the indexes above lead with `userId`, so that question was a
  /// scan of the whole trail.
  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// Why somebody stopped being on shift.
enum ShiftCloseReason {
  /// They signed out. Closed at their last action, not at the click.
  SIGN_OUT
  /// No activity for `SHIFT_IDLE_MINUTES`. Closed at the last action.
  AUTO_IDLE
  /// Ran past `SHIFT_MAX_HOURS`. Needs a manager to look at it.
  AUTO_CAP
  /// They signed in somewhere else, so this segment ended.
  BRANCH_CHANGE
  /// A manager closed or corrected it by hand.
  MANUAL
}

/// How a shift came to exist.
enum ShiftSource {
  /// Opened by signing in. The ordinary case, and the whole point.
  LOGIN
  /// Added by a manager for somebody who worked without signing in.
  MANUAL
}

/// Attendance: who was working, where, and for how long.
///
/// Deliberately separate from `CashDrawerSession`, which is money
/// accountability — see the note on that model. One person can work a whole
/// shift without touching cash, and a drawer can outlive a shift change.
///
/// ── Hours come from work, not from presence ─────────────────────────────────
///
/// `clockInAt` is the sign-in. The end is `clockOutAt ?? lastActionAt`, and
/// `lastActionAt` is stamped by `requirePermission` — so it moves when somebody
/// *does* something, never merely because a browser is open. That distinction is
/// load-bearing: a kitchen display left on overnight polls `/api/pulse` for
/// twelve hours, and any presence-based clock would bill all of it.
///
/// ── One branch per shift ────────────────────────────────────────────────────
///
/// Signing in at a different location closes the open shift `BRANCH_CHANGE` and
/// starts a new one, so a day of cover work is two segments and each branch's
/// figures are genuinely its own. `activeShiftKey` holds the user id while open
/// and NULL afterwards, so the database — not application code — enforces that
/// nobody is clocked in twice. Same idiom as `CashDrawerSession.activeCashierKey`,
/// and a plain nullable-unique rather than a partial index for the reason given
/// there.
///
/// ── Corrections keep the original ───────────────────────────────────────────
///
/// `clockInAt` / `clockOutAt` are what the system observed and are never
/// rewritten. A manager's fix goes in the `adjusted*` columns and the effective
/// time is `adjusted ?? observed`, so a disputed timesheet can always be shown
/// both ways.
model StaffShift {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  /// The last time this person did something. The shift's honest end.
  lastActionAt DateTime?
  notes      String?
  /// Required. A shift with no branch would appear on no branch's tab, which
  /// loses the attendance rather than merely mislabelling it.
  branch     Branch    @relation(fields: [branchId], references: [id])
  branchId   String

  /// The day this shift is counted under, in the restaurant's timezone, stamped
  /// when it opens. A shift that runs 18:00 → 01:30 stays on the opening day
  /// rather than splitting. Stored rather than derived so range queries can use
  /// an index instead of converting timezones in SQL.
  businessDate DateTime @db.Date

  /// The user id while OPEN, NULL once closed. Uniqueness is the "you cannot be
  /// clocked in twice" rule.
  activeShiftKey String? @unique

  source   ShiftSource       @default(LOGIN)
  closedBy ShiftCloseReason?

  adjustedClockInAt  DateTime?
  adjustedClockOutAt DateTime?
  adjustedById       String?
  adjustedBy         User?     @relation("ShiftAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
  adjustedAt         DateTime?
  adjustReason       String?

  @@index([restaurantId, clockInAt])
  @@index([userId, clockInAt])
  @@index([restaurantId, branchId, businessDate])
  @@index([userId, businessDate])
  @@map("staff_shifts")
}

/// A physical location of a restaurant.
///
/// Multi-branch is opt-in: a restaurant with one location never has to think
/// about it. Every restaurant gets one branch marked `isDefault` so operational
/// rows always have somewhere to belong, and the columns below stay nullable so
/// existing data keeps working untouched.
model Branch {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name         String
  /// Short code used on order numbers and reports, e.g. "MAIN", "KANDY".
  code         String
  /// BRANCH by default, so every existing row keeps its meaning untouched.
  type         LocationType @default(BRANCH)
  managerId    String?
  manager      User?        @relation("LocationManager", fields: [managerId], references: [id], onDelete: SetNull)
  /// [OpeningHours] — same shape as the restaurant's own.
  openingHours Json?
  address      String?
  phone        String?
  isActive     Boolean      @default(true)
  /// Exactly one per restaurant; where unassigned records are counted.
  isDefault    Boolean      @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  tables           RestaurantTable[]
  orders           Order[]
  inventoryItems   InventoryItem[]
  cashDrawers      CashDrawerSession[]
  shifts           StaffShift[]
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  storageLocations StorageLocation[]
  stockCounts      StockCount[]
  purchases        Purchase[]
  stockBatches     StockBatch[]
  wastageRecords   WastageRecord[]
  stock            InventoryStock[]
  transfersOut     StockTransfer[]     @relation("TransferFrom")
  transfersIn      StockTransfer[]     @relation("TransferTo")
  productionOrders ProductionOrder[]
  approvalRequests ApprovalRequest[]
  coupons          Coupon[]
  instructions     BranchInstruction[]
  goodsReceipts    GoodsReceipt[]
  menu             FoodBranch[]
  kitchenStations  KitchenStation[]
  shiftNotes       ShiftNote[]
  notifications    Notification[]
  purchaseReturns  PurchaseReturn[]
  staffRoles       StaffRole[]
  accessLinks      Invite[]
  cashRegisters    CashRegister[]
  pettyCash        PettyCashRequest[]
  cashHandovers    CashHandover[]
  reservations     Reservation[]
  errorLogs        ErrorLog[]

  outgoingPayments OutgoingPayment[]
  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("branches")
}

/// One cashier's cash drawer, from open to close.
///
/// This is the money-accountability record, and it is deliberately separate
/// from StaffShift (which is attendance). A shift says who was working; a
/// drawer session says what cash they were responsible for and whether it
/// balanced. Expected cash is always recomputed from the session's own
/// payments and movements rather than stored as a running total, so a
/// late-arriving payment cannot silently desync the variance.
model CashDrawerSession {
  id            String       @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Which physical till. One per branch unless the owner adds more.
  registerId    String
  register      CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  /// Human handle for the paperwork, e.g. "CD-2026-000123".
  ///
  /// Unique per restaurant, not globally: the sequence is each restaurant's
  /// own, so a global index would make two tenants opening a till at the same
  /// moment collide on a number that means nothing to either of them.
  sessionNumber String

  openedById       String
  openedBy         User     @relation("DrawerOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  openingFloat     Int      @default(0)
  /// The petty cash tin's starting balance. Deliberately NOT part of the float:
  /// it is a different pile of money answering a different question.
  openingPettyCash Int      @default(0)
  openedAt         DateTime @default(now())
  openingNote      String?

  closedById     String?
  closedBy       User?     @relation("DrawerClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  /// What the cashier physically counted at close.
  countedCash    Int?
  /// What the system says should be there. Snapshotted at close for the record.
  expectedCash   Int?
  /// countedCash - expectedCash. Negative is short, positive is over.
  variance       Int?
  /// Required whenever the variance is not zero. A difference nobody explained
  /// on the night is a difference nobody can explain a week later.
  ///
  /// Also carries the owner's explanation when a drawer is closed on somebody
  /// else's behalf — "Ann went home without closing" is the whole story of that
  /// session and there is nowhere better to put it.
  varianceReason String?
  /// Closed by somebody other than the person who opened it.
  ///
  /// A forgotten drawer blocks the next cashier from that till, so an owner can
  /// close it for them. That is a different fact from a cashier counting their
  /// own money and it is marked as one: `countedCash` null here means nobody
  /// counted, and the variance is genuinely unknown rather than zero.
  closedOnBehalf Boolean   @default(false)
  closingNote    String?

  /// Who signed off a variance large enough to stop at PENDING_REVIEW.
  reviewedById String?
  reviewedBy   User?     @relation("DrawerReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  status CashDrawerStatus @default(OPEN)

  /// Uniqueness, done by the database rather than by a read-then-write check.
  ///
  /// Both hold an id while the session is OPEN and NULL once it is not, and
  /// Postgres does not collide NULLs in a unique index. So these say exactly
  /// "one open session per till" and "one open session per cashier" without a
  /// partial index, which would be invisible to the Prisma schema and show up
  /// as drift on every migrate diff.
  activeRegisterKey String? @unique
  activeCashierKey  String? @unique

  movements  CashMovement[]
  payments   Payment[]
  pettyCash  PettyCashRequest[]
  handedOver CashHandover[]     @relation("HandoverFromSession")
  receivedAs CashHandover[]     @relation("HandoverToSession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, sessionNumber])
  @@index([restaurantId, status, openedAt])
  @@index([openedById, status])
  @@index([restaurantId, branchId, openedAt])
  @@index([registerId, openedAt])
  @@map("cash_drawer_sessions")
}

/// A physical till. One counter, one drawer, one person accountable at a time.
///
/// Branch alone was too coarse: it made "who is short Rs 500" unanswerable at a
/// site with two counters, and it made the uniqueness rule wrong in both
/// directions — two cashiers could open the same branch, one cashier could not
/// open two branches. The register is the thing a session actually belongs to.
///
/// A restaurant that has never thought about registers gets "Counter 1" created
/// for each branch on demand and never sees a picker.
model CashRegister {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  sessions  CashDrawerSession[]
  handovers CashHandover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([restaurantId, isActive])
  @@map("cash_registers")
}

/// Cash added to or removed from an open drawer for a reason that is not a sale.
///
/// Branch and register are not copied here on purpose. Both are reachable
/// through the session with one join, the session is their only writer, and a
/// copy is only ever another way for the two to disagree.
model CashMovement {
  id        String            @id @default(cuid())
  sessionId String
  session   CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type               CashMovementType
  amount             Int
  reason             String
  /// Receipt, invoice or slip number, where there is one.
  reference          String?
  /// Set when this movement is the cash half of a petty cash payment.
  pettyCashRequestId String?
  pettyCashRequest   PettyCashRequest? @relation(fields: [pettyCashRequestId], references: [id], onDelete: SetNull)
  /// Set when this movement is the cash half of an approved accountant
  /// payment (supplier settlement or expense) paid from the drawer.
  outgoingPaymentId  String?
  outgoingPayment    OutgoingPayment?  @relation(fields: [outgoingPaymentId], references: [id], onDelete: SetNull)
  /// Set when this movement is a refund, so "which refunds were recorded
  /// against a drawer, and which were not" has an answer. A refund given when
  /// no drawer is open anywhere writes no movement at all, and without this
  /// link there is nothing to notice its absence by.
  paymentId          String?
  payment            Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?             @relation("CashMovementBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@index([sessionId, type])
  @@index([paymentId])
  @@map("cash_movements")
}

/// A small expense paid in cash, from raising it to paying it.
///
/// The request row is the object, not a wrapper around one: it has a life after
/// approval — paid, receipted — that ApprovalRequest has no vocabulary for.
/// Only PAID moves money, which is the whole control.
model PettyCashRequest {
  id           String             @id @default(cuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// The drawer session it was paid against. Null until paid.
  sessionId    String?
  session      CashDrawerSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  category    String
  description String
  amount      Int
  /// Receipt or invoice number.
  reference   String?
  paidFrom    PettyCashSource @default(PETTY_FUND)
  status      PettyCashStatus @default(PENDING)

  requestedById String?
  requestedBy   User?    @relation("PettyRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("PettyDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  paidById String?
  paidBy   User?     @relation("PettyPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt   DateTime?

  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, branchId, status, requestedAt])
  @@index([sessionId])
  @@map("petty_cash_requests")
}

/// Passing the till from one cashier to the next.
///
/// The outgoing session is CLOSED by the handover and the counted amount opens
/// a new one for the incoming cashier. A session with two owners cannot
/// attribute a variance, which is the only reason drawer sessions exist — so
/// responsibility is transferred by ending one and starting another, with this
/// row linking them so the chain of custody stays readable.
model CashHandover {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  registerId   String
  register     CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)

  fromSessionId String
  fromSession   CashDrawerSession  @relation("HandoverFromSession", fields: [fromSessionId], references: [id], onDelete: Cascade)
  /// Created when the incoming cashier accepts. Null while pending or declined.
  toSessionId   String?
  toSession     CashDrawerSession? @relation("HandoverToSession", fields: [toSessionId], references: [id], onDelete: SetNull)

  fromUserId String
  fromUser   User   @relation("HandoverFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("HandoverTo", fields: [toUserId], references: [id], onDelete: Cascade)

  /// What the system said should be in the drawer at handover.
  expectedAmount Int
  /// What the outgoing cashier physically counted.
  countedAmount  Int
  variance       Int
  note           String?

  status     CashHandoverStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  acceptedAt DateTime?

  @@index([restaurantId, branchId, createdAt])
  @@index([toUserId, status])
  @@map("cash_handovers")
}

/// A place stock physically sits — main store, bar fridge, kitchen line.
///
/// Separate from Branch: one branch can have several stores, and a transfer
/// between two of them is a real movement that must show in the ledger.
model StorageLocation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name      String
  code      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items          InventoryItem[]
  movements      StockMovement[]
  stockCounts    StockCount[]
  purchases      Purchase[]
  batches        StockBatch[]
  wastageRecords WastageRecord[]
  stock          InventoryStock[]
  goodsReceipts  GoodsReceipt[]
  transfersFrom  StockTransfer[]  @relation("TransferFromStorage")
  transfersTo    StockTransfer[]  @relation("TransferToStorage")

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@index([restaurantId, branchId])
  @@map("storage_locations")
}

/// A physical stock take.
///
/// Counting is deliberately a two-step process. Typing a number records what
/// was on the shelf; it does not move stock. Only an explicit approval by
/// someone holding INVENTORY_ADJUST posts the variance to the ledger. That is
/// what stops a mistyped count from quietly rewriting the balance, and it
/// leaves a named person attached to every correction.
model StockCount {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  reference String
  status    StockCountStatus @default(DRAFT)
  notes     String?

  countedById String?
  countedBy   User?    @relation("CountCountedBy", fields: [countedById], references: [id], onDelete: SetNull)
  countedAt   DateTime @default(now())

  approvedById String?
  approvedBy   User?     @relation("CountApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  lines     StockCountLine[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, reference])
  @@index([restaurantId, status, countedAt])
  @@index([restaurantId, branchId, countedAt])
  @@map("stock_counts")
}

/// One item on a stock take: what the system thought, what was on the shelf.
model StockCountLine {
  id           String        @id @default(cuid())
  stockCountId String
  stockCount   StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Snapshotted when the line is entered, in base units, so a later sale does
  /// not change what the counter was comparing against.
  systemQty   Float
  countedQty  Float
  /// countedQty - systemQty, in base units. Negative is a shortfall.
  variance    Float
  enteredUnit StockUnit?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockCountId, itemId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}

/// A versioned recipe.
///
/// A recipe belongs either to a menu item (`foodId`) or to an inventory item it
/// produces (`producesItemId`) — the latter is a prep recipe, e.g. a batch of
/// burger sauce. Both kinds are the same shape, which is what lets a menu
/// recipe reference a prep recipe as though it were an ingredient.
///
/// ── Versioning ──────────────────────────────────────────────────────────────
///
/// Editing a recipe never rewrites the existing row. A new version is created
/// and the old one is deactivated, because the old one is what historical sales
/// were costed and depleted against. An order item pins the exact recipe id it
/// used, so a burger sold in January still explains itself after March's recipe
/// change.
model Recipe {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Set when this is a menu item's recipe.
  foodId         String?
  food           Food?          @relation(fields: [foodId], references: [id], onDelete: Cascade)
  /// Set when this is a prep recipe producing stock.
  producesItemId String?
  producesItem   InventoryItem? @relation("RecipeProduces", fields: [producesItemId], references: [id], onDelete: Cascade)

  name     String?
  version  Int     @default(1)
  /// Exactly one version per food/prep item is active at a time.
  isActive Boolean @default(true)

  /// How much one batch makes. A menu recipe makes one portion; a make-ahead
  /// recipe might make 2 kg of sauce, and 20 g of that is 1% of a batch.
  ///
  /// New make-ahead recipes are created with a yield of 1, so "make 100" means
  /// 100 and the scaling division is a no-op. Recipes migrated from the old
  /// production specs keep the batch size they were written with.
  yieldQty  Float      @default(1)
  yieldUnit StockUnit?

  /// Days the finished product keeps, for a make-ahead recipe. Drives the
  /// expiry date stamped on the batch a kitchen job creates.
  shelfLifeDays Int?

  prepNotes String?

  createdById String?
  createdBy   User?   @relation("RecipeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  ingredients      RecipeIngredient[]
  usedIn           RecipeIngredient[] @relation("SubRecipe")
  orderItems       OrderItem[]
  productionOrders ProductionOrder[]

  consumedByOptions VariantOption[] @relation("OptionConsumption")
  @@index([restaurantId, foodId, isActive])
  @@index([restaurantId, producesItemId, isActive])
  @@map("recipes")
}

// Two partial unique indexes enforce "one active version per owner" and live in
// SQL only, because Prisma cannot express a WHERE clause on a unique index:
//
//   recipes_active_produces_key  (restaurantId, producesItemId)
//   recipes_active_food_key      (restaurantId, foodId)
//
// both WHERE "isActive" AND the id IS NOT NULL AND "archivedAt" IS NULL. They
// were added by 20260912090000_recipes_and_production_merge. Until then this was
// a convention that `findFirst(orderBy: version desc)` happened to honour, which
// meant a second active row made the resolver pick a winner arbitrarily.

/// One line of a recipe: either a raw inventory item or a nested prep recipe.
model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// A raw ingredient drawn straight from stock.
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  /// A prep recipe used as an ingredient, e.g. burger sauce.
  subRecipeId     String?
  subRecipe       Recipe?        @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Cascade)

  quantity       Float
  unit           StockUnit
  /// Trim, peel and spillage, as a percentage on top of the quantity. 5 means
  /// 105 g must leave stock for a recipe that needs 100 g on the plate.
  wastagePercent Float     @default(0)
  sortOrder      Int       @default(0)
  notes          String?

  createdAt DateTime @default(now())

  @@index([recipeId])
  @@index([inventoryItemId])
  @@index([subRecipeId])
  @@map("recipe_ingredients")
}

/// How much of each inventory item an order has actually taken from stock.
///
/// This is the idempotency record for depletion. Reconciliation computes what
/// the order *should* have consumed from its current lines, compares it with
/// what it *has* consumed according to this table, and posts only the
/// difference. That single mechanism covers every case the spec asks for:
/// running twice changes nothing, raising 2 burgers to 3 deducts one more,
/// dropping 3 to 1 returns two, and cancelling returns everything.
model OrderStockDepletion {
  id           String        @id @default(cuid())
  restaurantId String
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Net base units taken from stock for this order so far. Positive means
  /// stock has left; zero means everything has been returned.
  appliedQty Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, itemId])
  @@index([restaurantId, orderId])
  @@map("order_stock_depletions")
}

/// What a particular supplier charges for a particular item.
///
/// The link is many-to-many on purpose: one supplier sells many things, and any
/// item worth buying usually has a second source for when the first runs out or
/// puts its prices up. The purchase unit lives here rather than on the item
/// because it is the supplier's packaging — one sells chicken by the 10 kg box,
/// another by the kilo.
model SupplierItem {
  id           String        @id @default(cuid())
  restaurantId String
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// The supplier's own code for it, quoted on their invoices.
  supplierSku          String?
  purchaseUnit         StockUnit?
  /// Base units in one purchase unit, when the supplier's packaging differs
  /// from how the item is stocked.
  unitsPerPurchaseUnit Float?
  /// Last agreed price per purchase unit, minor units.
  price                Int        @default(0)
  /// Days between ordering and delivery — drives reorder suggestions.
  leadTimeDays         Int?
  /// The supplier will not sell less than this, in purchase units.
  minOrderQty          Float?
  isPreferred          Boolean    @default(false)
  isActive             Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, itemId])
  @@index([restaurantId, itemId])
  @@map("supplier_items")
}

/// A delivery against a purchase order — a goods received note.
///
/// Receiving is a separate record rather than a status flip because a single
/// order is often delivered in instalments, and each arrival has its own date,
/// its own receiver and its own rejected quantity. Those are facts about the
/// delivery, not about the order.
model GoodsReceipt {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseId   String
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  number      String
  /// The supplier's own delivery note or invoice number.
  supplierRef String?
  notes       String?

  /// Where this delivery actually landed.
  ///
  /// Receiving used to be hard-wired to the order's own branch, so a van
  /// diverted to another site could not be recorded truthfully — the stock went
  /// onto the wrong shelf in the books and the difference surfaced weeks later
  /// as a variance nobody could explain. Null means "wherever the order said",
  /// which is the ordinary case.
  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locationId String?
  location   StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  receivedById String?
  receivedBy   User?    @relation("ReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedAt   DateTime @default(now())

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now())

  @@unique([restaurantId, number])
  @@index([restaurantId, purchaseId])
  @@index([restaurantId, receivedAt])
  @@map("goods_receipts")
}

/// One item on a delivery: how much turned up, and how much was sent back.
///
/// Only `acceptedQty` reaches stock. Rejected goods are recorded but never
/// posted to the ledger — they were never ours.
model GoodsReceiptLine {
  id             String        @id @default(cuid())
  receiptId      String
  receipt        GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseItem  @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// All in the purchase line's own unit.
  acceptedQty  Float
  rejectedQty  Float      @default(0)
  unit         StockUnit?
  /// What it actually cost on this delivery, per unit — suppliers change
  /// prices between order and delivery, and the ledger records what was paid.
  unitCost     Int        @default(0)
  rejectReason String?
  batchNo      String?
  expiryDate   DateTime?

  createdAt DateTime @default(now())

  @@index([receiptId])
  @@index([itemId])
  @@map("goods_receipt_lines")
}

/// Goods sent back to a supplier after they were accepted into stock.
///
/// Distinct from rejecting on delivery: this stock was ours, counted and
/// costed, so returning it is a real outward movement in the ledger.
model PurchaseReturn {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseId   String?
  purchase     Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplierId   String?
  supplier     Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Where the goods went back from. A return is a stock movement out of one
  /// store room, and it had no branch at all — `createPurchaseReturn` posted
  /// its ledger row with no branch, so the restaurant-wide quantity fell while
  /// no location's balance moved. That is the exact drift the reconciliation
  /// report exists to find.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  number String
  reason String
  notes  String?

  createdById String?
  createdBy   User?    @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  lines PurchaseReturnLine[]

  @@unique([restaurantId, number])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, supplierId])
  @@index([restaurantId, branchId, createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id       String         @id @default(cuid())
  returnId String
  return   PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId   String
  item     InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity Float
  unit     StockUnit?
  unitCost Int        @default(0)

  @@index([returnId])
  @@map("purchase_return_lines")
}

/// What an item cost, each time it was bought.
///
/// Written on every receipt so a price trend survives even after the purchase
/// order is archived. This is the table behind "chicken has gone up 15% since
/// January", which is the question an owner actually asks.
model PurchasePriceHistory {
  id           String        @id @default(cuid())
  restaurantId String
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?     @relation("PriceHistorySupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  /// Cost per base unit, minor units — normalised so prices quoted per box and
  /// per kilo can be compared on one chart.
  unitCost   Int
  quantity   Float
  unit       StockUnit?
  receiptId  String?
  recordedAt DateTime   @default(now())

  @@index([restaurantId, itemId, recordedAt])
  @@map("purchase_price_history")
}

/// A batch or lot of stock, with its own expiry.
///
/// Only created for items with `trackBatches` on. Most restaurant stock does
/// not need it — nobody lots their salt — but anything with a short life or a
/// recall risk does, and for those the batch is what makes "which delivery was
/// this from?" answerable.
///
/// `remainingQty` is decremented as the batch is drawn down. It is a cache of
/// the batch's own movements in the same way an item balance is, and is written
/// only alongside them.
model StockBatch {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  batchNo      String
  expiryDate   DateTime?
  /// Base units received into this batch.
  receivedQty  Float
  /// Base units left. Zero means the batch is used up, not that it never was.
  remainingQty Float
  /// Cost per base unit for this batch specifically — the groundwork FIFO and
  /// batch-accurate costing would need.
  unitCost     Int       @default(0)

  locationId String?
  location   StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  movements         StockMovement[]
  wastage           WastageRecord[]     @relation("WastageBatch")
  transferLines     StockTransferLine[]
  productionOutputs ProductionOutput[]

  @@unique([itemId, batchNo])
  @@index([restaurantId, expiryDate])
  @@index([itemId, remainingQty])
  @@index([restaurantId, branchId])
  @@map("stock_batches")
}

/// Something thrown away.
///
/// Wastage is recorded as a movement immediately, not on approval. The food is
/// already in the bin — refusing to write it down until a manager signs off
/// would leave the system claiming stock that visibly does not exist, and the
/// person who threw it away is rarely the person who can approve it. Approval
/// is therefore a review of a fact, not permission for it, which is also what
/// makes the approval queue honest: it is a list of things that happened, not
/// a list of things waiting to happen.
model WastageRecord {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Base units removed from stock.
  quantity        Float
  /// What the user typed, before conversion.
  quantityEntered Float?
  enteredUnit     StockUnit?
  /// quantity × average cost at the time, minor units. Snapshotted because the
  /// cost of what was wasted is a fact about that day, not today's price.
  costValue       Int        @default(0)

  reason     WastageReason
  reasonNote String?
  notes      String?
  /// Optional photograph, stored like every other image via /api/media.
  photoUrl   String?

  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locationId String?
  location   StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  batchId    String?
  batch      StockBatch?      @relation("WastageBatch", fields: [batchId], references: [id], onDelete: SetNull)

  status       WastageStatus @default(RECORDED)
  createdById  String?
  createdBy    User?         @relation("WastageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   User?         @relation("WastageApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  movementId String?

  /// Set when the waste was thrown away while making something — the run's
  /// page lists it, and its value is expensed rather than carried into the
  /// prepared item.
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, createdAt])
  @@index([restaurantId, reason, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, branchId, createdAt])
  @@index([itemId, createdAt])
  @@index([productionOrderId])
  @@map("wastage_records")
}

/// Stock of one item at one location.
///
/// The existing `InventoryItem.quantity` stays as the restaurant-wide available
/// total, so every existing query, recipe deduction and alert keeps working
/// untouched. This table adds the location breakdown underneath it, and the
/// two are written together inside the same transaction.
///
/// The three quantities are deliberately separate and never summed into one
/// number by the schema:
///
///   available — on the shelf, sellable now
///   reserved  — spoken for by an approved transfer that has not left yet
///   inTransit — dispatched from somewhere else and not yet received here
///
/// Mixing them is the classic multi-location bug: stock that is physically in a
/// van gets counted as available at both ends, and the branch that is about to
/// run out looks fine.
model InventoryStock {
  id                String           @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// The operational location — branch, production house or warehouse.
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Optional shelf within that location.
  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)

  available Float @default(0)
  reserved  Float @default(0)
  inTransit Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uniqueness is enforced by two PARTIAL indexes created in the migration, not
  // by @@unique here. A plain unique on the three columns would not work:
  // Postgres treats NULLs as distinct, so every posting for stock with no shelf
  // assigned would insert another row rather than finding the existing one.
  // The migration therefore declares:
  //
  //   unique (itemId, branchId)                    where storageLocationId is null
  //   unique (itemId, branchId, storageLocationId) where storageLocationId is not null
  //
  // Prisma cannot upsert against a partial index, so applyLocationDelta reads
  // then writes under the item row lock instead.
  @@index([itemId, branchId, storageLocationId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, itemId])
  // Prisma's nested include emits `WHERE branchId IN (...)` with no tenant
  // predicate, so without an index leading on branchId every dashboard render
  // sequentially scanned this shared table — cost scaling with total platform
  // rows rather than one restaurant's.
  @@index([branchId])
  @@map("inventory_stock")
}

/// A movement of stock between two locations.
///
/// Stock leaves the source when the transfer is DISPATCHED, not when it is
/// requested or approved — a promise to send something does not move it. It
/// arrives at the destination only when RECEIVED. Between those two points it
/// belongs to neither location's available figure and sits in the destination's
/// inTransit, which is what makes a van full of chicken visible instead of
/// invisible.
model StockTransfer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  number       String
  fromBranchId String
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranchId   String
  toBranch     Branch @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)

  /// Which shelf it leaves and which it lands on. Optional, because a
  /// restaurant that has never defined a storage area still transfers between
  /// locations. When both branches are the same these turn the transfer into a
  /// move between two stores inside one site — the branch total is unchanged
  /// and only the shelf positions differ.
  fromStorageId String?
  fromStorage   StorageLocation? @relation("TransferFromStorage", fields: [fromStorageId], references: [id], onDelete: SetNull)
  toStorageId   String?
  toStorage     StorageLocation? @relation("TransferToStorage", fields: [toStorageId], references: [id], onDelete: SetNull)

  status TransferStatus @default(REQUESTED)
  notes  String?

  requestedById  String?
  requestedBy    User?     @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt    DateTime  @default(now())
  approvedById   String?
  approvedBy     User?     @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  dispatchedById String?
  dispatchedBy   User?     @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  dispatchedAt   DateTime?
  receivedById   String?
  receivedBy     User?     @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedAt     DateTime?
  rejectReason   String?

  lines StockTransferLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, fromBranchId])
  @@index([restaurantId, toBranchId])
  @@index([restaurantId, requestedAt])
  @@map("stock_transfers")
}

/// One item on a transfer.
///
/// `sentQty` is never overwritten by what turned up. A dispatch of 30 that
/// arrives as 28 keeps both numbers and records the difference, because
/// quietly turning 30 into 28 destroys the only evidence that two went missing.
model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Asked for at request time, in base units.
  requestedQty   Float
  /// Actually sent. Set at dispatch and never changed afterwards.
  sentQty        Float?
  /// Actually accepted at the far end.
  receivedQty    Float?
  /// receivedQty - sentQty. Negative means stock went missing on the way.
  variance       Float?
  varianceReason TransferVarianceReason?
  varianceNote   String?

  unit     StockUnit?
  batchId  String?
  batch    StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  unitCost Int         @default(0)

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([itemId])
  @@map("stock_transfer_lines")
}

/// A production recipe: raw materials in, finished stock out.
///
/// Deliberately separate from the menu `Recipe`. A menu recipe turns stock into
/// a plate for a guest; a production spec turns stock into different stock. The
/// chain is raw material → production spec → finished product → menu recipe →
/// sale, and collapsing the two middle steps would make a burger patty both an
/// ingredient and a dish.
/// Deprecated. Superseded by `Recipe` with `producesItemId` set, which is the
/// same idea with versioning, nesting and a UI. Rows were copied into `recipes`
/// by 20260912090000_recipes_and_production_merge and are kept read-only for one
/// release so the backfill stays repairable. Nothing writes these tables.
model ProductionSpec {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name          String
  /// The inventory item one batch produces.
  outputItemId  String
  outputItem    InventoryItem @relation("ProductionSpecOutput", fields: [outputItemId], references: [id], onDelete: Cascade)
  /// How much one batch yields, in the output item's base unit.
  outputQty     Float
  /// Days the finished product keeps; drives the batch expiry date.
  shelfLifeDays Int?

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  ProductionSpecItem[]
  orders ProductionOrder[]

  @@index([restaurantId, isActive])
  @@map("production_specs")
}

model ProductionSpecItem {
  id     String         @id @default(cuid())
  specId String
  spec   ProductionSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  itemId String
  item   InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Consumed per batch, in `unit`.
  quantity Float
  unit     StockUnit?

  @@unique([specId, itemId])
  @@map("production_spec_items")
}

/// One production run at a production house.
model ProductionOrder {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// The production house doing the work.
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// The make-ahead recipe being made.
  recipeId     String?
  recipe       Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// The recipe's name at the time, so a finished job stays readable even if the
  /// recipe is later renamed, superseded or archived.
  recipeName   String?
  /// Deprecated: replaced by `recipeId`. Kept so the backfill stays repairable.
  specId       String?
  spec         ProductionSpec? @relation(fields: [specId], references: [id], onDelete: SetNull)
  /// What this run produced (redesignkitchenjob.md). Written on every run since
  /// the Make Item flow and backfilled from production_outputs; a legacy run
  /// that never completed has none.
  outputItemId String?
  outputItem   InventoryItem?  @relation("ProducedItem", fields: [outputItemId], references: [id], onDelete: SetNull)
  /// The form's request key: the same batch submitted twice is recorded once.
  clientRequestId String?

  number      String
  batchNumber String?
  status      ProductionStatus @default(DRAFT)

  /// Labour, power and anything else the run cost beyond its ingredients.
  /// Materials alone understate what a finished item is worth to make.
  overheadCost   Int                       @default(0)
  /// How many to make, and how many came out — both in the output item's own
  /// unit. These counted BATCHES until 20260912090000, which is why `unit` used
  /// to disagree with them.
  plannedQty     Float
  actualQty      Float?
  unit           StockUnit?
  variance       Float?
  varianceReason ProductionVarianceReason?
  varianceNote   String?

  /// Sum of what the raw materials actually cost, minor units.
  totalCost Int @default(0)
  /// totalCost / actualQty, minor units. The finished item's cost, not a price.
  unitCost  Int @default(0)

  productionDate DateTime?
  expiryDate     DateTime?
  notes          String?

  requestedById String?
  requestedBy   User?     @relation("ProductionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?     @relation("ProductionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  consumption ProductionConsumption[]
  outputs     ProductionOutput[]
  /// Production waste recorded with this run — expensed, never part of the
  /// prepared item's value.
  wastage     WastageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId, status])
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, outputItemId, completedAt])
  @@index([recipeId])
  @@map("production_orders")
}

/// A raw material actually consumed by a run.
model ProductionConsumption {
  id      String          @id @default(cuid())
  orderId String
  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId  String
  item    InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Base units taken out of stock.
  quantity Float
  unit     StockUnit?
  /// Cost per base unit at the time, minor units. Snapshotted so the run's cost
  /// does not drift when supplier prices change afterwards.
  unitCost Int        @default(0)
  lineCost Int        @default(0)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([itemId])
  @@map("production_consumption")
}

/// Finished goods a run produced.
model ProductionOutput {
  id      String          @id @default(cuid())
  orderId String
  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId  String
  item    InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity Float
  unit     StockUnit?
  unitCost Int         @default(0)
  batchId  String?
  batch    StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([itemId])
  @@map("production_outputs")
}

/// A request for someone senior to authorise something.
///
/// Approvals exist for actions that are legitimate but worth a second pair of
/// eyes — a large refund, a deep discount, a stock adjustment that writes off
/// value. The threshold is per restaurant, because Rs 10,000 is a rounding
/// error to one owner and a day's takings to another.
///
/// The request records what was *asked for*, never mutating the thing it is
/// about. Nothing happens on the underlying record until it is approved, which
/// is what stops "pending" and "done" being the same state.
model ApprovalRequest {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  kind   ApprovalKind
  status ApprovalStatus @default(PENDING)

  /// What the request is about, e.g. 'Order' + the order id.
  entity   String
  entityId String?
  /// The value that triggered the threshold, in minor units where money.
  amount   Int?
  reason   String
  /// [ApprovalPayload] — what to apply if approved.
  payload  Json?

  requestedById String?
  requestedBy   User?    @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status, requestedAt])
  @@index([restaurantId, kind, status])
  @@index([restaurantId, branchId, status])
  @@map("approval_requests")
}

/// Recent server errors, so a reference code shown to a user can be turned back
/// into its cause.
///
/// Next strips error messages in production — correctly, since an unfiltered
/// error names tables and columns to anyone who can load the page — and hands
/// the browser a digest instead. Keeping the pair here is what makes that digest
/// answerable. In-memory capture was tried first and is not enough: serverless
/// instances are short-lived, so the one that failed is rarely the one answering
/// the diagnostic.
///
/// Capped by the writer, never read on a request path, and best-effort — a
/// failure to record an error must never turn into a second error.
/**
 * What went wrong, and enough context to act on it (production.md §7, §12).
 *
 * §7 asks that every important error carry a request id, a timestamp, the
 * operation, the restaurant, the branch where applicable, the user where
 * appropriate, and useful information. This row used to carry the restaurant
 * and the route and nothing else, which made "a page failed for somebody
 * somewhere" the most an operator could ever learn.
 *
 * Worse, almost nothing reached it: only exceptions that escaped to Next's
 * `onRequestError` were persisted, and Server Actions — the majority of every
 * mutation in this application — were merely `console.error`'d by `runAction`
 * and then discarded. The commonest failures were the ones nobody could see.
 *
 * Secrets never land here: everything written goes through `redact()` first,
 * the same filter the audit log uses.
 */
model ErrorLog {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Where it happened, when the failing work belonged to one site.
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Who hit it. Null for guest surfaces and background work.
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The number shown to the user; the join key back to this row.
  digest  String?
  /// Correlates every log line and error from ONE request. Generated at
  /// ingress so a report of "it broke at 14:32" becomes a single lookup.
  requestId String?
  route   String?
  /// The named thing that was being attempted — 'collectPayment',
  /// 'receiveGoods'. A route says which screen; this says which operation,
  /// and a Server Action has no route worth the name.
  operation String?
  kind    String
  /// ERROR for something that broke, WARNING for something that coped, and
  /// CRITICAL for the money-and-stock integrity failures §7 singles out.
  severity  String  @default("ERROR")
  message String
  stack   String?
  /// The record involved, when there was one — the order that would not settle.
  entity   String?
  entityId String?

  /// §12 asks for safe investigation and resolution: an operator marks a row
  /// dealt with rather than deleting it, so the history of what went wrong and
  /// what was done about it both survive.
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?

  createdAt DateTime @default(now())

  @@index([digest])
  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@index([severity, createdAt])
  @@index([requestId])
  @@map("error_logs")
}

/**
 * The one background job queue (production.md §4, §13).
 *
 * ── Why this exists at all ──────────────────────────────────────────────────
 *
 * ARCHITECTURE.md states, correctly, that this system has no queues, no cron
 * and no workers by design: every deferred effect is computed lazily on read.
 * That rule earned its place and most of it still holds.
 *
 * It cannot hold for everything §13 asks for. A nightly integrity check across
 * every tenant, error-log retention, outbox trimming and backup verification
 * are not things a page render should do on somebody's behalf — they are slow,
 * they are not tied to any request, and computing them lazily means they
 * happen when a guest is waiting for a menu.
 *
 * So: ONE table, ONE scheduled function draining it, no worker process and no
 * queue library. Claiming is `FOR UPDATE SKIP LOCKED`, so two overlapping runs
 * of the scheduler cannot take the same job.
 */
model Job {
  id           String      @id @default(cuid())
  /// Which handler runs this — see src/server/jobs/handlers.ts.
  kind         String
  status       JobStatus   @default(QUEUED)
  /// Scoped to a tenant when the work is a tenant's; null for platform work.
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Handler input. Small — this is a job, not a payload store.
  payload      Json?

  /// Not before this moment. Retries push it out with backoff.
  runAt       DateTime @default(now())
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  lastError   String?
  /// What the handler had to say when it worked.
  result      String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Stops a recurring job being queued twice: the scheduler upserts on this.
  dedupeKey String? @unique

  @@index([status, runAt])
  @@index([kind, status])
  @@index([restaurantId, createdAt])
  @@map("jobs")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/**
 * A recovery code — the way back in when the authenticator is on a lost phone.
 *
 * Stored hashed, exactly like a password, and single-use. Without these, MFA on
 * the platform super-admin is a way to lock the owner out of their own
 * platform permanently, which is a worse outcome than the one it prevents.
 */
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the code. The plaintext is shown once, at enrolment.
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/**
 * Platform-wide switches the operator owns (production.md §8 Maintenance).
 *
 * Deliberately a tiny key/value table rather than a settings model with a
 * column per switch: the alternative is a migration every time the operator
 * needs a new flag, which in practice means the flag never gets added.
 */
model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/**
 * A restore test, and what it proved (production.md §10).
 *
 * §10 asks the Backups page to show the last restore test and its result, and
 * is explicit that the application must not pretend to perform backups the
 * database provider actually performs. Neon owns the backups and the PITR
 * window; what the application can honestly own is the record of somebody
 * having checked that a restore works.
 *
 * A backup nobody has ever restored is a belief, not a backup.
 */
model RestoreTest {
  id          String   @id @default(cuid())
  /// What was restored — a Neon branch name, a dump file.
  target      String
  /// PASSED, FAILED, or PARTIAL when it restored but something did not verify.
  outcome     String
  /// The point in time restored to, when the test was a PITR restore.
  restoredTo  DateTime?
  durationSec Int?
  notes       String?
  testedById  String?
  testedByName String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("restore_tests")
}

/// A short, signed remark on a financial record (acCal.md §17). Append-only
/// by construction: the feature ships no update or delete — a wrong note is
/// answered with another note, the way a paper daybook works.
model AccountantNote {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Scoping tag only — no FK on purpose; a note outlives branch reshuffles.
  branchId     String?

  /// What the note is pinned to: 'invoice' | 'order' | 'payment' |
  /// 'outgoingPayment' | 'issue' | 'bankLine'.
  entity   String
  entityId String
  body     String

  authorId   String?
  author     User?   @relation("AccountantNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Denormalised, so the signature survives the author's account.
  authorName String

  createdAt DateTime @default(now())

  @@index([restaurantId, entity, entityId, createdAt])
  @@map("accountant_notes")
}

enum BankLineStatus {
  UNMATCHED
  MATCHED
  /// The same line already arrived in an earlier statement.
  DUPLICATE
  /// Deliberately set aside — bank fees, someone else's money.
  IGNORED
}

/// One uploaded bank statement (acCal.md §6). The file itself is not kept —
/// only its parsed lines and a hash that refuses the same file twice.
model BankStatement {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?

  fileName   String
  /// sha256 of the normalised file content — the re-upload guard.
  importHash String
  lineCount  Int

  uploadedById   String?
  uploadedBy     User?   @relation("BankStatementUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByName String

  createdAt DateTime @default(now())

  lines BankStatementLine[]

  @@unique([restaurantId, importHash])
  @@map("bank_statements")
}

/// One line of a bank statement, matched (or not) to a system record.
model BankStatementLine {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  statementId  String
  statement    BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  lineDate    DateTime
  description String
  reference   String?
  /// Signed minor units: positive = money in (credit), negative = money out.
  amount      Int
  /// sha256(restaurantId|date|amount|normalised description) — how a line
  /// re-imported in a later statement is recognised as DUPLICATE.
  lineHash    String

  status      BankLineStatus @default(UNMATCHED)
  /// 'PAYMENT' | 'SUPPLIER_PAYMENT' | 'OUTGOING_PAYMENT' — which ledger the
  /// accepted match lives in.
  matchedType String?
  matchedId   String?
  matchedById String?
  matchedBy   User?          @relation("BankLineMatchedBy", fields: [matchedById], references: [id], onDelete: SetNull)
  matchedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([restaurantId, status, lineDate])
  @@index([restaurantId, lineHash])
  @@index([statementId])
  @@map("bank_statement_lines")
}
