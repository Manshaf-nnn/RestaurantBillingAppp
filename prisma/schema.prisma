// ============================================================================
// RestaurantOS — Multi-tenant Restaurant POS & QR Ordering Platform
// ----------------------------------------------------------------------------
// Conventions
//  * Every tenant-owned row carries `restaurantId` and is indexed on it.
//    All data access goes through the tenant-scoped repository helpers in
//    `src/server/db/tenant.ts` — never query a tenant table without a scope.
//  * Money is stored as INTEGER minor units (cents/paise). Never floats.
//  * Rates (tax, service charge, discounts) are stored as basis points
//    (10000 = 100.00%) so they stay exact.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // Include the serverless (AWS Lambda / Netlify Functions) engine binaries so
  // Prisma works at runtime on the host, not just on the local machine.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── enums ─────

enum UserRole {
  SUPER_ADMIN // platform operator, not bound to a restaurant
  OWNER
  MANAGER
  KITCHEN
  CASHIER
  WAITER
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

/// Platform onboarding lifecycle for a restaurant tenant.
enum RestaurantStatus {
  PENDING // registered, awaiting platform-admin approval
  ACTIVE // approved and live
  SUSPENDED // temporarily disabled by the platform admin
  REJECTED // registration declined
}

enum TableStatus {
  AVAILABLE
  ORDERING
  EATING
  WAITING_BILL
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum VariantKind {
  VARIANT // mutually-exclusive choices (Size: Small / Large)
  ADDON // additive extras (Extra cheese, Fries)
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  /// Walk-in rung up at the counter with no table held.
  COUNTER
}

/// How the order reached the system. Kept separate from OrderType because a
/// dine-in order can arrive by QR or be keyed in by a waiter, and reporting
/// wants to tell those apart without inventing a fake order type.
enum OrderChannel {
  QR
  STAFF
  COUNTER
  PHONE
  ONLINE
}

enum OrderStatus {
  PENDING // placed by guest, kitchen has not accepted
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  QR
  ONLINE
  WALLET
  BANK_TRANSFER
}

enum CashDrawerStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  /// Money added to the drawer that is not a sale (float top-up, change fund).
  CASH_IN
  /// Money taken out that is not a refund (supplier paid in cash, bank drop).
  CASH_OUT
}

enum ServiceRequestType {
  WATER
  PLATES
  BILL
  HELP
  CLEAN_TABLE
}

enum ServiceRequestStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_ITEM
}

enum StockUnit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  PACK
  BOTTLE
  DOZEN
  BOX
}

enum StockMovementType {
  PURCHASE
  /// Legacy: superseded by SALE. Kept so existing rows still read.
  CONSUMPTION
  /// Legacy: superseded by WASTAGE.
  WASTE
  /// Legacy: superseded by ADJUSTMENT_IN / ADJUSTMENT_OUT.
  ADJUSTMENT
  /// Legacy: superseded by RETURN_TO_SUPPLIER / CUSTOMER_RETURN.
  RETURN
  EXPIRY

  SALE
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_TO_SUPPLIER
  CUSTOMER_RETURN
  PRODUCTION
  OPENING_BALANCE
}

enum StockCountStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  CANCELLED
}

enum StockAlertLevel {
  OUT_OF_STOCK
  LOW_STOCK
  OVERSTOCK
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_READY
  ORDER_SERVED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  SERVICE_REQUEST
  LOW_STOCK
  STOCK_EXPIRY
  RESERVATION
  REVIEW
  SYSTEM
}

enum NotificationAudience {
  KITCHEN
  WAITER
  CASHIER
  MANAGEMENT
  CUSTOMER
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FeedbackCategory {
  FOOD
  SYSTEM
}

// ──────────────────────────────────────────────────────────── tenancy ──────

model Restaurant {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  description String?
  logoUrl     String?
  coverUrl    String?
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  country     String? @default("IN")
  postalCode  String?
  timezone    String  @default("Asia/Kolkata")
  locale      String  @default("en")
  currency    String  @default("INR")

  /// basis points — 500 = 5.00%
  taxRateBps       Int     @default(500)
  taxLabel         String  @default("GST")
  taxInclusive     Boolean @default(false)
  serviceChargeBps Int     @default(0)

  plan        SubscriptionPlan @default(TRIAL)
  trialEndsAt DateTime?

  /// Onboarding lifecycle. New self-service registrations start PENDING and
  /// require platform-admin approval; `isActive` mirrors whether the tenant is
  /// currently enabled (approved and not suspended).
  status          RestaurantStatus @default(ACTIVE)
  isActive        Boolean          @default(true)
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  /// [OpeningHours] — { mon: { open: "09:00", close: "23:00", closed: false }, ... }
  openingHours  Json?
  /// [ThemeConfig] — { primary: "24 95% 53%", radius: "0.75rem", mode: "system" }
  theme         Json?
  /// [PrinterConfig] — { kitchen: { width: 80 }, receipt: { width: 58 }, autoPrint: true }
  printerConfig Json?
  /// [PaymentConfig] — { cash: true, card: true, qr: true, upiId: "x@bank", online: false }
  paymentConfig Json?
  /// [FeatureFlags] — { reservations: true, loyalty: true, happyHour: false }
  features      Json?

  loyaltyEnabled      Boolean @default(true)
  /// points awarded per unit of currency spent, x100 (100 = 1 point per 1 currency)
  loyaltyEarnRateX100 Int     @default(100)
  /// minor units of currency each redeemed point is worth
  loyaltyPointValue   Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  categories       Category[]
  foods            Food[]
  tables           RestaurantTable[]
  customers        Customer[]
  orders           Order[]
  payments         Payment[]
  invoices         Invoice[]
  coupons          Coupon[]
  reservations     Reservation[]
  reviews          Review[]
  feedback         Feedback[]
  shiftNotes       ShiftNote[]
  suppliers        Supplier[]
  inventoryItems   InventoryItem[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  serviceRequests  ServiceRequest[]
  shifts           StaffShift[]
  mediaBackups     MediaBackup[]
  mediaAssets      MediaAsset[]
  invites          Invite[]
  menuSnapshots    RestaurantMenuSnapshot[]
  branches         Branch[]
  cashDrawers      CashDrawerSession[]
  storageLocations StorageLocation[]
  stockCounts      StockCount[]

  @@index([isActive])
  @@map("restaurants")
}

/// Backups of uploaded media for platform-level restore/migration.
/// Durable image storage.
///
/// Uploaded image bytes live *in the database*, not on the host's disk or in a
/// host-scoped blob store. This is deliberate: Netlify Blobs and the build
/// filesystem are scoped to a Netlify site, so moving the site to another
/// Netlify account (or simply redeploying onto a fresh one) silently destroys
/// every uploaded photo while the database still points at them. Postgres is
/// the only store that survives that move, so it is the source of truth and
/// nothing ever needs "restoring".
model MediaAsset {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  /// public filename — `<timestamp>-<hex>.<ext>`, served at /api/media/<key>
  key         String @unique
  contentType String
  size        Int
  /// sha-256 of `data`, used as a strong ETag for conditional requests
  checksum    String
  /// the image itself (bytea)
  data        Bytes

  /// mirrored copy on a CDN (Cloudinary) when one is configured; the row is
  /// still authoritative, so losing the CDN account costs performance, not data
  cdnUrl String?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@map("media_assets")
}

model MediaBackup {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  key         String? // internal key (uploads filename or blob key)
  originalUrl String // URL returned to tenant at upload time
  backupUrl   String? // URL in backup storage (Cloudinary) when available
  contentType String?
  size        Int?
  notes       String? // optional note about source (uploader, field name)

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@map("media_backups")
}

/// Snapshot of each restaurant menu item/category, mirrored to the platform admin so
/// changes are visible even when the tenant account is moved or the site changes.
model RestaurantMenuSnapshot {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  entityType   String // CATEGORY | FOOD
  entityId     String
  name         String
  slug         String?
  categoryName String?
  imageUrl     String?
  price        Int?
  snapshot     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, entityType, entityId])
  @@index([restaurantId, createdAt])
  @@map("restaurant_menu_snapshots")
}

// ───────────────────────────────────────────────── identity & access ───────

model User {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  role         UserRole @default(WAITER)
  /// extra permission keys granted on top of the role defaults
  permissions  String[] @default([])

  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions         Session[]
  tokens           VerificationToken[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  createdOrders    Order[]             @relation("OrderCreatedBy")
  receivedPayments Payment[]           @relation("PaymentReceivedBy")
  stockMovements   StockMovement[]
  shifts           StaffShift[]
  handledRequests  ServiceRequest[]    @relation("RequestHandledBy")
  createdInvites   Invite[]
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  drawersOpened    CashDrawerSession[] @relation("DrawerOpenedBy")
  drawersClosed    CashDrawerSession[] @relation("DrawerClosedBy")
  cashMovements    CashMovement[]      @relation("CashMovementBy")
  countsCounted    StockCount[]        @relation("CountCountedBy")
  countsApproved   StockCount[]        @relation("CountApprovedBy")

  @@unique([email])
  @@index([restaurantId, role])
  @@index([restaurantId, isActive])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token — the raw token is never stored
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// Short-lived invite links that create a temporary staff session for a role.
model Invite {
  id           String     @id @default(cuid())
  token        String     @unique
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         UserRole
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, isActive])
  @@map("invites")
}

// ─────────────────────────────────────────────────────────────── menu ──────

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  imageUrl    String?
  icon        String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  foods Food[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model Food {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  description String?
  imageUrl    String?

  /// minor units
  price         Int
  /// optional promotional price, minor units; when set and lower, it wins
  discountPrice Int?
  /// food cost, used for profit reporting
  costPrice     Int  @default(0)

  prepTimeMinutes Int        @default(15)
  calories        Int?
  isVeg           Boolean    @default(false)
  spiceLevel      SpiceLevel @default(NONE)
  isAvailable     Boolean    @default(true)
  isRecommended   Boolean    @default(false)
  isPopular       Boolean    @default(false)
  tags            String[]   @default([])
  allergens       String[]   @default([])
  sortOrder       Int        @default(0)

  /// happy-hour pricing (minutes from midnight, restaurant timezone)
  happyHourPrice    Int?
  happyHourStartMin Int?
  happyHourEndMin   Int?
  happyHourDays     Int[] @default([])

  soldCount   Int @default(0)
  ratingSum   Int @default(0)
  ratingCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  variantGroups VariantGroup[]
  recipe        RecipeItem[]
  orderItems    OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, isPopular])
  @@map("foods")
}

model VariantGroup {
  id     String @id @default(cuid())
  foodId String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  name       String
  kind       VariantKind @default(VARIANT)
  isRequired Boolean     @default(false)
  minSelect  Int         @default(0)
  maxSelect  Int         @default(1)
  sortOrder  Int         @default(0)

  options VariantOption[]

  @@index([foodId])
  @@map("variant_groups")
}

model VariantOption {
  id      String       @id @default(cuid())
  groupId String
  group   VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name        String
  /// price delta in minor units; may be negative
  priceDelta  Int     @default(0)
  isDefault   Boolean @default(false)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  @@index([groupId])
  @@map("variant_options")
}

/// Links a menu item to the ingredients it consumes — drives auto stock deduction.
model RecipeItem {
  id       String        @id @default(cuid())
  foodId   String
  food     Food          @relation(fields: [foodId], references: [id], onDelete: Cascade)
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// quantity consumed per single unit sold, in the inventory item's unit
  quantity Float

  @@unique([foodId, itemId])
  @@index([itemId])
  @@map("recipe_items")
}

// ────────────────────────────────────────────────────────────── floor ──────

model RestaurantTable {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  number    String
  label     String?
  area      String?     @default("Main")
  capacity  Int         @default(4)
  status    TableStatus @default(AVAILABLE)
  notes     String?
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  reservations    Reservation[]
  serviceRequests ServiceRequest[]
  branch          Branch?          @relation(fields: [branchId], references: [id])
  branchId        String?

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@map("restaurant_tables")
}

// ─────────────────────────────────────────────────────────── customers ─────

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?
  notes String?

  loyaltyPoints Int       @default(0)
  /// lifetime spend, minor units
  totalSpent    Int       @default(0)
  totalOrders   Int       @default(0)
  lastOrderAt   DateTime?
  isBlocked     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  reservations Reservation[]
  reviews      Review[]
  redemptions  CouponRedemption[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastOrderAt])
  @@map("customers")
}

// ────────────────────────────────────────────────────────────── orders ─────

model Order {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orderNumber   String
  type          OrderType     @default(DINE_IN)
  /// How the order reached the system; see OrderChannel.
  channel       OrderChannel  @default(STAFF)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  tableId    String?
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// snapshot so the ticket stays correct even if the customer record changes
  customerName  String
  customerPhone String
  customerEmail String?

  /// anonymous browser session that placed the order — used to authorise
  /// guest access to tracking/billing without an account
  guestSessionId String?

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // ── money, all minor units ───────────────────────────────
  subtotal        Int @default(0)
  discountTotal   Int @default(0)
  loyaltyDiscount Int @default(0)
  taxTotal        Int @default(0)
  serviceCharge   Int @default(0)
  tipAmount       Int @default(0)
  roundingAdj     Int @default(0)
  grandTotal      Int @default(0)
  paidTotal       Int @default(0)

  taxRateBps       Int @default(0)
  serviceChargeBps Int @default(0)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  notes            String?
  cancelReason     String?
  estimatedMinutes Int     @default(0)
  guestCount       Int?

  /// Parked at the counter so the cashier can serve someone else and come back.
  /// A held bill stays out of the active queue but is never cancelled.
  heldAt     DateTime?
  holdReason String?

  /// Split lineage — this bill was created by splitting `splitFrom`.
  splitFromId String?
  splitFrom   Order?  @relation("OrderSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splits      Order[] @relation("OrderSplit")

  /// Merge lineage — this bill's items moved into `mergedInto`, and it was
  /// closed. Kept rather than deleted so the day's history stays auditable.
  mergedIntoId String?
  mergedInto   Order?  @relation("OrderMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Order[] @relation("OrderMerge")

  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  invoice        Invoice?
  review         Review?
  redemptions    CouponRedemption[]
  stockMovements StockMovement[]
  branch         Branch?            @relation(fields: [branchId], references: [id])
  branchId       String?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, placedAt])
  @@index([restaurantId, paymentStatus])
  @@index([restaurantId, placedAt])
  /// Lets /api/pulse read MAX("updatedAt") per restaurant as an index scan.
  /// Every station polls that, so it has to stay O(1) as history grows.
  @@index([restaurantId, updatedAt])
  @@index([restaurantId, tableId, status])
  @@index([customerId])
  @@index([guestSessionId])
  @@index([restaurantId, heldAt])
  @@map("orders")
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodId  String?
  food    Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  /// immutable snapshots — the menu may change after the order is placed
  name            String
  imageUrl        String?
  unitPrice       Int
  quantity        Int             @default(1)
  /// [SelectedOption[]] — [{ groupId, groupName, optionId, name, priceDelta, kind }]
  options         Json?
  optionsTotal    Int             @default(0)
  lineTotal       Int
  costPrice       Int             @default(0)
  notes           String?
  status          OrderItemStatus @default(QUEUED)
  isVeg           Boolean         @default(false)
  prepTimeMinutes Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([foodId])
  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model ServiceRequest {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  type        ServiceRequestType
  status      ServiceRequestStatus @default(OPEN)
  note        String?
  handledById String?
  handledBy   User?                @relation("RequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())

  @@index([restaurantId, status, createdAt])
  @@map("service_requests")
}

// ──────────────────────────────────────────────── payments & billing ───────

model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method         PaymentMethod
  status         PaymentStatus @default(UNPAID)
  amount         Int
  tenderedAmount Int?
  changeAmount   Int           @default(0)

  /// gateway / UPI reference
  reference     String?
  gateway       String?
  gatewayRef    String?
  /// intent identifier for dynamic QR payments
  intentId      String? @unique
  qrPayload     String?
  failureReason String?

  receivedById String?
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  cashDrawerSession   CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id])
  cashDrawerSessionId String?

  @@index([restaurantId, status, createdAt])
  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  number    String
  issuedAt  DateTime  @default(now())
  emailedAt DateTime?
  pdfUrl    String?
  /// [InvoiceSnapshot] — frozen copy of the bill at issue time
  snapshot  Json

  @@unique([restaurantId, number])
  @@index([restaurantId, issuedAt])
  @@map("invoices")
}

model Coupon {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  code             String
  description      String?
  type             CouponType @default(PERCENT)
  /// PERCENT → basis points, FIXED → minor units
  value            Int
  minOrderAmount   Int        @default(0)
  maxDiscount      Int?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usedCount        Int        @default(0)
  perCustomerLimit Int?
  isActive         Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount     Int
  createdAt  DateTime  @default(now())

  @@unique([couponId, orderId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────────────────────────────────── inventory ─────

model Supplier {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InventoryItem[]
  purchases Purchase[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("suppliers")
}

model InventoryItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String
  sku      String?
  barcode  String?
  category String?

  /// The unit the ledger is kept in. Every movement is converted to this
  /// before it is posted, so a balance is never a mix of kg and grams.
  unit                 StockUnit  @default(PIECE)
  /// How the supplier sells it, e.g. BOX. Converted on receipt.
  purchaseUnit         StockUnit?
  /// How a recipe draws it down, e.g. GRAM. Converted on consumption.
  consumptionUnit      StockUnit?
  /// Base units in one purchase unit — "1 box = 10 kg" is 10 when the base
  /// unit is KG. Only needed when the conversion is not a standard one
  /// (kg↔g, litre↔ml, dozen↔piece are known); a box or packet is whatever
  /// this restaurant's supplier says it is.
  unitsPerPurchaseUnit Float?

  /// Cached balance. The ledger is the source of truth; this is derived from
  /// it on every post and must never be written to directly.
  quantity     Float  @default(0)
  reorderLevel Float  @default(0)
  minStock     Float  @default(0)
  /// Par level. Above this the item is flagged as overstocked.
  maxStock     Float?

  /// Weighted average cost per base unit, minor units. Recomputed on receipt.
  costPerUnit      Int  @default(0)
  /// What the last purchase actually cost per base unit, minor units.
  lastPurchaseCost Int?

  trackExpiry  Boolean          @default(false)
  trackBatches Boolean          @default(false)
  expiryDate   DateTime?
  storageArea  String?
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive     Boolean          @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements     StockMovement[]
  recipeItems   RecipeItem[]
  purchaseItems PurchaseItem[]
  branch        Branch?         @relation(fields: [branchId], references: [id])
  branchId      String?

  stockCountLines StockCountLine[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@index([restaurantId, expiryDate])
  @@index([restaurantId, branchId, isActive])
  @@map("inventory_items")
}

model StockMovement {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type            StockMovementType
  /// Signed and always in the item's base unit: positive adds, negative removes.
  quantity        Float
  /// What the user actually entered, before conversion — kept so the ledger can
  /// show "500 g" rather than "0.5" when the base unit is kg.
  quantityEntered Float?
  enteredUnit     StockUnit?
  /// Running balance in base units immediately after this row was posted.
  /// Written inside the same transaction that moves the stock, so the ledger
  /// explains itself without replaying every earlier row.
  balanceAfter    Float?
  unitCost        Int               @default(0)
  reason          String?
  notes           String?

  /// What caused this movement — 'Purchase', 'Order', 'StockCount',
  /// 'Transfer' — plus the id of that record, so every row is traceable back
  /// to its source.
  referenceType String?
  referenceId   String?

  batchNo    String?
  expiryDate DateTime?

  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stockCountId String?
  stockCount   StockCount?      @relation(fields: [stockCountId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId   String?
  purchase     Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([itemId, createdAt])
  @@index([restaurantId, type, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Purchase {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  number     String
  status     PurchaseStatus @default(DRAFT)
  total      Int            @default(0)
  notes      String?
  orderedAt  DateTime?
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseItem[]
  movements StockMovement[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String        @id @default(cuid())
  purchaseId String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity  Float
  unitCost  Int
  lineTotal Int

  @@index([purchaseId])
  @@map("purchase_items")
}

// ──────────────────────────────────────────── reservations & feedback ──────

model Reservation {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String?
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName    String
  customerPhone   String
  customerEmail   String?
  partySize       Int               @default(2)
  reservedAt      DateTime
  durationMinutes Int               @default(90)
  status          ReservationStatus @default(PENDING)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, reservedAt])
  @@index([restaurantId, status])
  @@map("reservations")
}

model Review {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  rating        Int
  foodRating    Int?
  serviceRating Int?
  comment       String?
  reply         String?
  repliedAt     DateTime?
  isPublished   Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@map("reviews")
}

/// Anonymous one-tap guest feedback — no personal details, so guests actually leave it.
model Feedback {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  category FeedbackCategory @default(FOOD)

  /// 1 = unhappy 😞 … 4 = delighted 😍
  rating      Int
  comment     String?
  tableNumber String?
  createdAt   DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([category, createdAt])
  @@map("feedback")
}

/// Digital shift handover — notes one manager leaves for the next shift.
model ShiftNote {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  body       String
  authorId   String?
  authorName String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([restaurantId, resolved, createdAt])
  @@map("shift_notes")
}

// ─────────────────────────────────────────── ops: notify / audit / hr ──────

model Notification {
  id           String                @id @default(cuid())
  restaurantId String
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience     NotificationAudience?

  type   NotificationType
  title  String
  body   String?
  /// [NotificationData] — { orderId, orderNumber, tableNumber, amount, ... }
  data   Json?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorName String?
  action    String
  entity    String
  entityId  String?
  /// [AuditDiff]
  before    Json?
  /// [AuditDiff]
  after     Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  branchId  String?

  @@index([restaurantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model StaffShift {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  notes      String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  branchId   String?

  @@index([restaurantId, clockInAt])
  @@index([userId, clockInAt])
  @@map("staff_shifts")
}

/// A physical location of a restaurant.
///
/// Multi-branch is opt-in: a restaurant with one location never has to think
/// about it. Every restaurant gets one branch marked `isDefault` so operational
/// rows always have somewhere to belong, and the columns below stay nullable so
/// existing data keeps working untouched.
model Branch {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  /// Short code used on order numbers and reports, e.g. "MAIN", "KANDY".
  code      String
  address   String?
  phone     String?
  isActive  Boolean @default(true)
  /// Exactly one per restaurant; where unassigned records are counted.
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  tables           RestaurantTable[]
  orders           Order[]
  inventoryItems   InventoryItem[]
  cashDrawers      CashDrawerSession[]
  shifts           StaffShift[]
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  storageLocations StorageLocation[]
  stockCounts      StockCount[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("branches")
}

/// One cashier's cash drawer, from open to close.
///
/// This is the money-accountability record, and it is deliberately separate
/// from StaffShift (which is attendance). A shift says who was working; a
/// drawer session says what cash they were responsible for and whether it
/// balanced. Expected cash is always recomputed from the session's own
/// payments and movements rather than stored as a running total, so a
/// late-arriving payment cannot silently desync the variance.
model CashDrawerSession {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  openedById   String
  openedBy     User     @relation("DrawerOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  openingFloat Int      @default(0)
  openedAt     DateTime @default(now())
  openingNote  String?

  closedById   String?
  closedBy     User?     @relation("DrawerClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt     DateTime?
  /// What the cashier physically counted at close.
  countedCash  Int?
  /// What the system says should be there. Snapshotted at close for the record.
  expectedCash Int?
  /// countedCash - expectedCash. Negative is short, positive is over.
  variance     Int?
  closingNote  String?

  status CashDrawerStatus @default(OPEN)

  movements CashMovement[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status, openedAt])
  @@index([openedById, status])
  @@map("cash_drawer_sessions")
}

/// Cash added to or removed from an open drawer for a reason that is not a sale.
model CashMovement {
  id        String            @id @default(cuid())
  sessionId String
  session   CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type        CashMovementType
  amount      Int
  reason      String
  createdById String?
  createdBy   User?            @relation("CashMovementBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([sessionId, createdAt])
  @@map("cash_movements")
}

/// A place stock physically sits — main store, bar fridge, kitchen line.
///
/// Separate from Branch: one branch can have several stores, and a transfer
/// between two of them is a real movement that must show in the ledger.
model StorageLocation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name      String
  code      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items       InventoryItem[]
  movements   StockMovement[]
  stockCounts StockCount[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("storage_locations")
}

/// A physical stock take.
///
/// Counting is deliberately a two-step process. Typing a number records what
/// was on the shelf; it does not move stock. Only an explicit approval by
/// someone holding INVENTORY_ADJUST posts the variance to the ledger. That is
/// what stops a mistyped count from quietly rewriting the balance, and it
/// leaves a named person attached to every correction.
model StockCount {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  reference String
  status    StockCountStatus @default(DRAFT)
  notes     String?

  countedById String?
  countedBy   User?    @relation("CountCountedBy", fields: [countedById], references: [id], onDelete: SetNull)
  countedAt   DateTime @default(now())

  approvedById String?
  approvedBy   User?     @relation("CountApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  lines     StockCountLine[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, reference])
  @@index([restaurantId, status, countedAt])
  @@map("stock_counts")
}

/// One item on a stock take: what the system thought, what was on the shelf.
model StockCountLine {
  id           String        @id @default(cuid())
  stockCountId String
  stockCount   StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Snapshotted when the line is entered, in base units, so a later sale does
  /// not change what the counter was comparing against.
  systemQty   Float
  countedQty  Float
  /// countedQty - systemQty, in base units. Negative is a shortfall.
  variance    Float
  enteredUnit StockUnit?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockCountId, itemId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}
