enum CashDrawerStatus {
  OPEN
  /// Counted, but the variance was large enough to need a manager's eyes.
  /// The drawer takes no more money in this state — the count cannot go stale.
  PENDING_REVIEW
  CLOSED
}

/// Why cash moved, which also says which way it moved.
///
/// The direction is not stored: it is derived from the type by `DIRECTION` in
/// `features/cashdrawer/movement-types.ts`, so a type added later cannot end up
/// with the wrong sign in one place and the right one in another.
///
/// There is deliberately no CASH_SALE member. A cash sale is already attributed
/// by stamping `Payment.cashDrawerSessionId`, and mirroring it here would give
/// the same rupees two rows that can disagree the first time a payment is voided.
enum CashMovementType {
  /// Money added to the drawer that is not a sale (float top-up, change fund).
  CASH_IN
  /// Money taken out that is not a refund (supplier paid in cash, bank drop).
  CASH_OUT
  /// Extra float brought to the till mid-shift.
  ADDITIONAL_CASH
  /// Cash handed back to a customer.
  CASH_REFUND
  /// A petty cash expense paid out of the drawer rather than the petty tin.
  PETTY_CASH_PAID
  /// Drawer to petty tin. Leaves the drawer, arrives in the fund.
  PETTY_FUND_TOPUP
  /// Paid to somebody in cash — a supplier at the door, a courier.
  CASH_PAID_OUT
  /// Skimmed to the safe so the till is not holding the day's takings.
  CASH_DROP
  /// Taken to the bank.
  BANK_DEPOSIT
  /// A correction signed off by a manager.
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  /// The cash half of an approved accountant payment, paid from a drawer.
  /// System-written only — never offered on the cashier's manual form, so a
  /// hand-keyed CASH_PAID_OUT and an approved expense can never be confused
  /// or double-counted.
  EXPENSE_PAID
  /// Cash returning to a drawer when a paid expense is reversed.
  EXPENSE_REVERSED
}

/// Where a petty cash expense was actually paid from.
///
/// The petty fund and the drawer are separate tins. Only a DRAWER payment
/// changes expected drawer cash; a PETTY_FUND payment reduces the fund alone.
enum PettyCashSource {
  DRAWER
  PETTY_FUND
}

/// A petty cash request's life.
///
/// Four live states, not the six a first draft usually reaches for: a submitted
/// request *is* pending approval, and "recorded" is not a state but the effect
/// of PAID — paying writes the ledger row and the drawer movement in one
/// transaction, so paid-but-unrecorded cannot exist.
enum PettyCashStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum CashHandoverStatus {
  PENDING
  ACCEPTED
