# ============================================================================
# RestaurantOS — PRODUCTION environment
# Copy to `.env` on your server and fill in real values.
#   cp .env.production.example .env && nano .env
# ============================================================================

# ── Your domain ──────────────────────────────────────────────────────────────
# MUST be your real https:// domain. This drives cookie security and the
# websocket URL. Get these wrong and logins will not stick.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_SOCKET_URL="https://yourdomain.com"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Use a strong password. This points at the Postgres you install on the server.
DATABASE_URL="postgresql://restaurantos:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/restaurantos?schema=public"

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Generate EACH of these with:  openssl rand -base64 48
JWT_ACCESS_SECRET="PASTE_A_48_BYTE_RANDOM_STRING_HERE"
JWT_REFRESH_SECRET="PASTE_A_DIFFERENT_48_BYTE_RANDOM_STRING_HERE"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
# Optional session tuning — the defaults are right for almost everyone.
# Super-admin sessions are absolute (sign in again every day); staff sessions
# slide forward each day the app is used; a refresh token is swapped for a new
# one once it is a day old; a just-swapped token still works for 30 seconds so
# two tabs refreshing at the same moment both stay signed in.
# ADMIN_REFRESH_TOKEN_TTL_HOURS="12"
# REFRESH_ROTATE_AFTER_HOURS="24"
# REFRESH_GRACE_SECONDS="30"

# ── First platform admin (created by `npm run db:seed:prod`) ─────────────────
SUPER_ADMIN_EMAIL="you@yourdomain.com"
SUPER_ADMIN_PASSWORD="A_STRONG_ADMIN_PASSWORD"

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000

# ── Redis (optional — only needed to run more than one app instance) ─────────
# Leave blank for a single server; the app falls back to in-process handling.
REDIS_URL=""

# ── Cloudinary (optional — for image uploads) ────────────────────────────────
# If blank, uploaded images are stored on the server's disk under public/uploads
# (works fine on a VPS). Fill these to store images on Cloudinary instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Email (recommended — verification, password reset, receipts) ─────────────
# Without SMTP, those emails are only written to the server log. Use any SMTP
# provider (Gmail app password, Brevo, Zoho, Mailgun, your host's SMTP, …).
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="RestaurantOS <no-reply@yourdomain.com>"

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"
