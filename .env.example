# ─── Database ────────────────────────────────────────────────────────────────
# Local docker-compose default. Point at any PostgreSQL 14+ instance.
DATABASE_URL="postgresql://restaurantos:restaurantos@localhost:5432/restaurantos?schema=public"

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Used for rate limiting and the Socket.IO adapter when running >1 instance.
# If omitted the app falls back to an in-process implementation automatically.
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-dev-access-secret-change-me-please-32chars"
JWT_REFRESH_SECRET="change-me-dev-refresh-secret-change-me-please-32chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
# Platform-admin sessions are shorter and absolute: the operator signs in daily.
ADMIN_REFRESH_TOKEN_TTL_HOURS="12"
# A refresh token rotates once it is this old, not on every access-token expiry.
# Must exceed the 12h "remember me: off" lifetime (asserted at startup).
REFRESH_ROTATE_AFTER_HOURS="24"
# After a rotation, the old token still resolves to its successor for this long,
# so two tabs refreshing at once cannot log each other out.
REFRESH_GRACE_SECONDS="30"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# ─── Cloudinary (optional: image uploads) ────────────────────────────────────
# Without these, uploads fall back to local disk under /public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Email (optional: verification, receipts) ────────────────────────────────
# Without these, emails are logged to the console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="RestaurantOS <no-reply@restaurantos.app>"

# ─── Backups ─────────────────────────────────────────────────────────────────
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_OWNER_EMAIL="owner@restaurantos.dev"
SEED_PASSWORD="Password123!"

# Un-pooled connection used only for migrations (Neon: host without "-pooler")
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
