# ============================================================================
# TLS and reverse proxy for TableFlow.
#
# Three kinds of hostname reach this box, and all three must serve HTTPS:
#
#   1. tableflow.markui.lk        the platform: dashboard, POS, kitchen, admin
#   2. <anything>.markui.lk       a restaurant's subdomain, handed out by you
#   3. copperspoon.lk             a restaurant's OWN domain, pointed at us
#
# Only the first is known when this file is written. The other two arrive
# whenever a restaurant is onboarded, and nobody wants to edit a config file
# and reload a proxy to sell a subscription — so certificates are issued ON
# DEMAND, the first time each hostname is requested.
#
# The `ask` endpoint is what stops that being an open door: Caddy asks the app
# whether it serves the hostname before requesting a certificate for it. Point
# a DNS record you own at this IP and Caddy will refuse it, which is the point.
# See src/app/api/public/domain-allowed/route.ts.
# ============================================================================

{
	email admin@markui.lk          # ← CHANGE ME: where Let's Encrypt writes

	on_demand_tls {
		ask http://app:3000/api/public/domain-allowed
		interval 2m
		burst 5                    # at most 5 new certificates per 2 minutes
	}
}

# ── The platform itself ─────────────────────────────────────────────────────
# Named explicitly rather than left to on-demand, so the dashboard keeps its
# certificate even if the app is down and cannot answer the ask endpoint.
tableflow.markui.lk {
	encode zstd gzip
	reverse_proxy app:3000 {
		# The app reads x-forwarded-host to work out which restaurant a
		# visitor is asking for. Caddy sets these by default; they are named
		# here because tenant resolution silently breaks without them.
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# ── Every restaurant hostname ───────────────────────────────────────────────
# Subdomains you hand out AND custom domains restaurants point at you, both
# covered by the same block. `on_demand` means: get the certificate when the
# first request arrives, having asked the app first.
:443 {
	tls {
		on_demand
	}

	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}

		# WebSockets for the kitchen and live-floor screens. This is the whole
		# reason the app is not on a serverless host.
		header_up Upgrade {>Upgrade}
		header_up Connection {>Connection}
	}
}
