# ============================================================================
# Copy to `.env` beside this file and fill in. NEVER commit the filled copy.
#
# Every value marked SECRET comes from Manshaf and must arrive through a
# password manager or a one-time secret link — not WhatsApp, not email.
# ============================================================================

# ── The database. SECRET ────────────────────────────────────────────────────
# The Neon connection string. It MUST be the POOLED one: the host contains
# "-pooler". src/server/db/prisma.ts refuses the direct host in production,
# because an app opening unpooled connections exhausts Neon's limit.
DATABASE_URL=

# ── Sessions. SECRET ────────────────────────────────────────────────────────
# Copy the EXISTING values from the current host. Generating new ones signs
# every user out and invalidates every refresh token in circulation.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── The platform administrator. SECRET ──────────────────────────────────────
# Re-seeded on every deploy while SUPER_ADMIN_PASSWORD is set, so a password
# changed by hand reverts on the next deploy. That is expected.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── The scheduled job runner. SECRET ────────────────────────────────────────
# /api/jobs/run compares this in constant time and refuses everything without
# it. The `jobs` container in docker-compose.yml uses the same value.
JOBS_SECRET=

# ── Public identity ─────────────────────────────────────────────────────────
# The domain people actually type, WITH the scheme. The Secure flag on session
# cookies and every absolute link derive from it, so a wrong value here logs
# people out on production and looks like an auth bug.
NEXT_PUBLIC_APP_URL=https://tableflow.markui.lk

# Left unset on purpose: this box runs the real Socket.IO server, so live
# updates work. Set it to "true" only if the kitchen screens misbehave and you
# want the polling fallback the old host used.
# NEXT_PUBLIC_REALTIME_DISABLED=true

# ── Optional ────────────────────────────────────────────────────────────────
# REDIS_URL=            # rate limits count in Postgres without it
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEON_API_KEY=         # lets /admin/backups show the real recovery window
# NEON_PROJECT_ID=
# SMTP_HOST=            # verification and password-reset email
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
