# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local
.env.production

# secrets handed over out of band — the env values arrive as a document, and
# `git add .` must never be able to pick one up
*.docx
*.xlsx

# private keys. This repo is public, and a deploy key generated in the wrong
# working directory lands right here.
*.key
*_rsa
*_ed25519
*_deploy
id_*
!id_*.md

# prisma
/prisma/*.db
/prisma/migrations/dev.db*

# backups, uploads & logs
/backups
/public/uploads
/logs
*.log

# ide
.vscode/*
!.vscode/extensions.json
.idea

# testing
/coverage

# typescript
*.tsbuildinfo
